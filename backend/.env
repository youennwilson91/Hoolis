# Configuration pour la préversion protégée par mot de passe

# Activer la protection par mot de passe
PASSWORD_PROTECTED=true

# Mot de passe pour accéder à la préversion (changez cette valeur !)
PREVIEW_PASSWORD=HoolisPreview2024!

# Autres paramètres de production
DEBUG=false
DJANGO_SECRET_KEY=your-production-secret-key-here

# Base de données
DB_NAME=hoolis_preview_db
DB_HOST=localhost
DB_PORT=1433

# Hosts autorisés (ajoutez votre domaine de préversion)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine-preview.com 

ACCESS_TOKEN_LIFETIME=24