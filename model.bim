          }
        ],
        "measures": [
          {
            "name": "Volume Hedged",
            "expression": [
              "",
              "[Spread Qty] + [Stocks & Supply]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "7455c364-a074-482d-aedd-7d49955364f8",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Position",
            "expression": [
              "",
              "[Stocks & Supply] + [Spread Qty]",
              "    + CALCULATE (",
              "        [Sales],",
              "        'Teap Snapshot Entity Month Quantities'[Week Pattern] <> \"M\"",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "d9524621-c315-4645-a4b0-25e423e46117",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "% Hedged sales",
            "expression": [
              "",
              "VAR _cal =",
              "    DIVIDE ( [Stocks & Supply] + [Spread Qty], - [Sales], BLANK () )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "        BLANK (),",
              "        _cal",
              "    )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "4713ef4f-09d0-4437-aba6-bb220e6ac080"
          },
          {
            "name": "Residual Price Effect",
            "expression": [
              "",
              "[Result excl. Structure] + [Structure]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "17f118f8-9133-4d65-8de9-4077aeaec13a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Price effect",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Teap Snapshot Entity Month Quantities',",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF PRI'[very_short_name],",
              "        'Teap Snapshot Entity Month Quantities'[Week Pattern]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"sales\", [Sales],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF PRI'[very_short_name],",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                USERELATIONSHIP ( 'Teap Snapshot Entity Month Quantities'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF PRI'[very_short_name],",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                )",
              "            )",
              "    )",
              "RETURN",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [sales] ) / 1000"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "9e42c058-b259-46ed-a984-b45e11b4493d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical Position",
            "expression": [
              "",
              "SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "a48b5925-f5d8-4a16-bb9c-f63e1391fd2a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Stocks & Supply",
            "expression": [
              "",
              "[Stocks] + [Supply]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "32c57a6a-b9e6-41e9-8b1b-9dcc0dcbad79"
          },
          {
            "name": "Diff Qty",
            "expression": [
              "",
              "IF (",
              "    SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "    [Realized Qty] - [Forecast Qty]",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "8670720a-f45c-4f5d-908e-3964b83aabbf",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Last Known Quotation Day",
            "expression": [
              "",
              "LASTDATE ( 'Last Quotation Day'[last_day] )"
            ],
            "formatString": "dd/mm/yyyy",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "46fc6e5e-0c39-4308-9376-5ac4a8eeab92",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "# Office Days",
            "expression": [
              "",
              "SUM ( 'Office Days'[quoted_day] )"
            ],
            "formatString": "0",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "7c9cc389-37ed-479b-b9ea-7f0c17bc7504"
          },
          {
            "name": "# monthly remaining quotation days",
            "expression": [
              "",
              "IF (",
              "    DATEDIFF ( TODAY (), [Last Quotation Day], DAY ) >= 0,",
              "    CALCULATE ( [# Office Days], 'Office Days'[date] > TODAY () ) + 1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "ca3704b9-0992-4dde-a5bf-c69212514ca9"
          },
          {
            "name": "Last Quotation Day",
            "expression": [
              "",
              "CALCULATE (",
              "    LASTDATE ( 'Office Days'[date] ),",
              "    'Office Days'[quoted_day] = 1,",
              "    ALL ( 'REF Entities' )",
              ")"
            ],
            "formatString": "dd/mm/yyyy",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "57834d3f-8235-41e8-a975-4d85f84f2f4d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "# weekly remaining quotation days",
            "expression": [
              "",
              "VAR max_week =",
              "    LASTDATE ( 'Last Week Construction Day'[last_week] )",
              "RETURN",
              "    IF (",
              "        DATEDIFF ( TODAY (), max_week, DAY ) >= 0,",
              "        CALCULATE (",
              "            [# Office Days],",
              "            'Office Days'[date] < max_week,",
              "            TODAY () < 'Office Days'[date]",
              "        ),",
              "        0",
              "    )"
            ],
            "formatString": "0",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "bea84523-651d-495a-9ea3-a684dfd845ab"
          },
          {
            "name": "Sales Big Bird",
            "expression": [
              "",
              "IF ( [One Selected Snapshot], SUM ( 'Extrait Big Bird'[quantité] ), BLANK () )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Sales",
            "lineageTag": "3b16fea6-f6f0-48f8-b644-58a4f84437cf",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Sales - Sales Big Bird.",
            "expression": [
              "",
              "[Sales] - [Sales Big Bird]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Sales",
            "lineageTag": "1976ee31-2420-467c-b550-086c188e9807",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Last Construction Day w-1",
            "expression": [
              "",
              "LASTDATE ( 'Last Week Construction Day'[last_week] )"
            ],
            "formatString": "dd/mm/yyyy",
            "displayFolder": "Hedging Meeting",
            "lineageTag": "54695f70-385e-443d-8d9a-69d2bfad88e7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Contracted sales",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] = 0",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "73984064-a1c8-4e1f-a862-ef5df7ab1934"
          },
          {
            "name": "Contracted net position",
            "expression": [
              "",
              "IF (",
              "    [selected month] = \"(realised)\",",
              "    BLANK (),",
              "    CALCULATE (",
              "        [Contracted sales],",
              "        'Teap Pricing Formula Time Patterns'[Time Pattern] <> \"M\",",
              "        'Teap Pricing Formula Time Patterns'[Time Pattern] <> \"M-1\"",
              "    ) + [Stocks & Supply] + [Spread Qty]",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "549d0607-7461-4cbb-9545-9219f25cc756",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "% Hedged contracted sales",
            "expression": [
              "",
              "DIVIDE ( - [Volume Hedged], [Contracted sales], BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "1cad0e8b-6d4f-45a0-b95a-1548001c5990"
          },
          {
            "name": "% Performance",
            "expression": [
              "",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _maxsnapshotvalue =",
              "    CALCULATE (",
              "        SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "VAR _result =",
              "    DIVIDE ( [Diff selected snapshots], _maxsnapshotvalue, BLANK () )",
              "RETURN",
              "    IF ( _result <> 0, _result, BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "76b44881-ad63-40df-864b-9fb0f5fddd70"
          },
          {
            "name": "Diff selected snapshots",
            "expression": [
              "",
              "--takes the latest snapshot from a selection and compares its with the other selected snapshots",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _calculate =",
              "    CALCULATE (",
              "        SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "RETURN",
              "    IF (",
              "        ROUND (",
              "            _calculate - SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "            0",
              "        ) <> 0,",
              "        ROUND (",
              "            _calculate - SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "            0",
              "        ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "8b04a108-0654-4248-b377-d8b1a94b5818",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
