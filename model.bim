          {
            "name": "Forward Periods Averages",
            "mode": "import",
            "queryGroup": "Data\\Data (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server, Database, [MultiSubnetFailover=true]),",
                "    Data = Source{[Schema=\"dbo\",Item=\"pbi_forward_periods_averages\"]}[Data],",
                "    #\"Inserted Merged Column\" = Table.AddColumn(Data, \"Period\", each Text.Combine({Text.From([start_date], \"fr-FR\"), \" | \", Text.From([end_date], \"fr-FR\")}), type text),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Inserted Merged Column\",{{\"start_date\", Order.Ascending}})",
                "in",
                "    #\"Sorted Rows\""
              ]
            }
          }
        ],
