            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Physical hedge spread],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
