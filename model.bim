            "lineageTag": "edb46da9-6d0d-4d28-b3ed-ae948725fa7a"
          },
          {
            "name": "Month Reference",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( 'REF Snapshots'[Label] ),",
              "    FORMAT ( MAX ( 'REF Snapshots'[Reference Month] ), \"mmmm\" ),",
              "    \"\"",
              ")"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "bdf71f2d-8c12-4b13-9fec-f34841ce3a20"
          },
          {
            "name": "Month reference display",
            "expression": [
              "",
              "\"Reference month : \" & [Month Reference]"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "0fbb7ac9-4734-4c4c-ac8b-07292c803a28"
          },
          {
            "name": "selected month",
            "expression": [
              "",
              "VAR _last_snapshot =",
              "    CALCULATE (",
              "        SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "        'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "    )",
              "VAR _month =",
              "    SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] )",
              "RETURN",
              "    IF (",
              "        YEAR ( _month )",
              "            < CALCULATE (",
              "                YEAR ( MAX ( 'REF Snapshots'[Reference Month] ) ),",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            ),",
              "        \"(realised)\",",
              "        IF (",
              "            YEAR ( _month )",
              "                = CALCULATE (",
              "                    YEAR ( MAX ( 'REF Snapshots'[Reference Month] ) ),",
              "                    'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "                ),",
              "            SWITCH (",
              "                TRUE (),",
              "                MONTH ( _month )",
              "                    > CALCULATE (",
              "                        MONTH ( MAX ( 'REF Snapshots'[Reference Month] ) ),",
              "                        'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "                    ), \"(forward)\",",
              "                MONTH ( _month )",
              "                    = CALCULATE (",
              "                        MONTH ( MAX ( 'REF Snapshots'[Reference Month] ) ),",
              "                        'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "                    ), \"(current)\",",
              "                MONTH ( _month )",
              "                    < CALCULATE (",
              "                        YEAR ( MAX ( 'REF Snapshots'[Reference Month] ) ),",
              "                        'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "                    ), \"(realised)\"",
              "            ),",
              "            \"(forward)\"",
              "        )",
              "    )"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "01df93ce-01d7-4e70-9121-b951319eea5b"
          },
          {
            "name": "selected month display",
            "expression": [
              "",
              "VAR _display =",
              "    \" Selected month : \"",
              "        & FORMAT ( SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] ), \"mmmm\" ) & \" \"",
              "VAR _month =",
              "    SWITCH (",
              "        TRUE (),",
              "        [selected month] = \"(current)\", \"(present)\",",
              "        [selected month] = \"(realised)\", \"(past)\",",
              "        [selected month] = \"(forward)\", \"(future)\"",
              "    )",
              "RETURN",
              "    _display & _month"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "993bf4e1-46c0-421b-a2b1-26f81f72ff8f"
          },
          {
            "name": "Selected Period display",
            "expression": [
              "",
              "SWITCH (",
              "    SELECTEDVALUE ( 'Period Selection'[Period Selection] ),",
              "    \"Difference\", \"Selected Period: Difference\",",
              "    \"Realized\", \"Selected Period: Realized\",",
              "    \"Forecast\", \"Selected Period: Forecast\"",
              ")"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "656cb2f2-327d-4b7d-98ff-19e1d76d440f"
          },
          {
            "name": "Selected Snapshots Label",
            "expression": [
              "",
              "VAR snapshots =",
              "    VALUES ( 'REF Snapshots' )",
              "RETURN",
              "    IF (",
              "        AND ( ISCROSSFILTERED ( 'REF Snapshots' ), COUNTROWS ( snapshots ) == 2 ),",
              "        CALCULATE (",
              "            CONCATENATEX (",
              "                DISTINCT ( 'REF Snapshots'[Short Label Ref] ),",
              "                'REF Snapshots'[Short Label Ref] & UNICHAR ( 10 ),",
              "                \"- \"",
              "            )",
              "        ),",
              "        \"None\"",
              "    )"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "da29fe01-28cd-4d37-9bd6-17e220a7ecd0"
          },
          {
            "name": "Snapshot id",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( 'REF Snapshots'[Label] ),",
              "    \"Selected snapshot : \" & LEFT ( MAX ( 'REF Snapshots'[Short Label Ref] ), 19 ),",
              "    \"Please select a snapshot.\"",
              ")"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "6f0d66fc-8924-44bd-802a-6b0067ed52c5"
          },
          {
            "name": "Snapshot range",
            "expression": [
              "",
              "\"From: \" & [Min date] & \" - To: \" & [Max date]"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "6f3ca6c1-e3c6-4afe-8129-953ea77f5502"
          },
          {
            "name": "Blank",
            "formatString": "yyyy-mm-dd hh:nn:ss",
            "displayFolder": "Other Measures",
            "lineageTag": "ec2dec94-0d57-4029-aafe-12fa80e9770a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDateTimeCustom\":true}"
              }
            ]
          },
          {
            "name": "calendar filter",
            "expression": [
              "",
              "VAR _minDate =",
              "    MIN ( 'REF Snapshots'[Snapshot Starting Date] )",
              "VAR _maxDate =",
              "    MAX ( 'REF Snapshots'[Snapshot Last Date] )",
              "VAR _rangeStart =",
              "    MIN ( 'REF Calendar'[reference_month] )",
              "VAR _rangeEnd =",
              "    MAX ( 'REF Calendar'[reference_month] )",
              "VAR _slicer =",
              "    GENERATESERIES ( _minDate, _maxDate )",
              "VAR _t =",
              "    GENERATESERIES (",
              "        IF ( _rangeStart, _rangeStart, 0 ),",
              "        IF ( _rangeEnd <> BLANK (), _rangeEnd, 0 )",
              "    )",
              "VAR _count =",
              "    COUNTROWS ( _slicer )",
              "VAR _except =",
              "    COUNTROWS ( EXCEPT ( _slicer, _t ) )",
              "RETURN",
              "    IF ( _count <> _except, 0, 1 )"
            ],
            "formatString": "0",
            "displayFolder": "Other Measures",
            "lineageTag": "6dd92519-536a-4025-95ee-2d6228fe6523"
          },
          {
            "name": "Last Refresh",
            "expression": [
              "",
              "LASTDATE ( 'Data Refresh'[Last Refresh] ) & \" UTC\"",
              "//Last Refresh = \"Last refresh: \" & LASTDATE('Data Refresh'[Last Refresh]))"
            ],
            "displayFolder": "Other Measures",
            "lineageTag": "45eb2fc6-bf7f-440a-a1d3-d32bfa70b4e1"
          },
          {
            "name": "reference date filter",
            "expression": [
              "",
              "VAR _minDate =",
              "    MIN ( 'Forward Periods Averages'[reference_date] )",
              "VAR _maxDate =",
              "    MAX ( 'Forward Periods Averages'[reference_date] )",
              "VAR _rangeStart =",
              "    MIN ( 'REF Calendar'[reference_month] )",
              "VAR _rangeEnd =",
              "    MAX ( 'REF Calendar'[reference_month] )",
              "VAR _slicer =",
              "    GENERATESERIES ( _minDate, _maxDate )",
              "VAR _t =",
              "    GENERATESERIES ( _rangeStart, _rangeEnd )",
              "VAR _count =",
              "    COUNTROWS ( _slicer )",
              "VAR _except =",
              "    COUNTROWS ( EXCEPT ( _slicer, _t ) )",
              "RETURN",
              "    IF ( _count <> _except, 0, 1 )"
            ],
            "formatString": "0",
            "displayFolder": "Other Measures",
            "lineageTag": "860af480-e38d-43a8-b41b-c54ddab1d722"
          },
          {
            "name": "Structure display",
            "expression": [
              "",
              "IF (",
              "    [selected month] = \"(forward)\"",
              "        && ISBLANK ( [Structure] ) = FALSE (),",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Other Measures",
            "lineageTag": "e367cc38-7492-4251-a7e5-4ecc2921a072"
          },
          {
            "name": "selected month RD",
            "expression": [
              "",
              "VAR _reference_date =",
              "    SELECTEDVALUE ( 'Forward Periods Averages'[reference_date] )",
              "VAR _month =",
              "    SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] )",
              "RETURN",
              "    IF (",
              "        YEAR ( _month ) < YEAR ( _reference_date ),",
              "        \"(realised)\",",
              "        IF (",
              "            YEAR ( _month ) = YEAR ( _reference_date ),",
              "            SWITCH (",
              "                TRUE (),",
              "                MONTH ( _month ) > MONTH ( _reference_date ), \"(forward)\",",
              "                MONTH ( _month ) = MONTH ( _reference_date ), \"(current)\",",
              "                MONTH ( _month ) < MONTH ( _reference_date ), \"(realised)\"",
              "            ),",
              "            \"(forward)\"",
              "        )",
              "    )"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "5d1f6f09-3356-4245-b2c2-20c6353a04e6"
          },
          {
            "name": "selected month display RD",
            "expression": [
              "",
              "VAR _display =",
              "    \" Selected month : \"",
              "        & FORMAT ( SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] ), \"mmmm\" ) & \" \"",
              "VAR _month =",
              "    SWITCH (",
              "        TRUE (),",
              "        [selected month RD] = \"(current)\", \"(present)\",",
              "        [selected month RD] = \"(realised)\", \"(past)\",",
              "        [selected month RD] = \"(forward)\", \"(future)\"",
              "    )",
              "RETURN",
              "    _display & _month"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "54851641-ed38-4230-8e73-0099e5733283"
          },
          {
            "name": "Please select a snapshot",
            "expression": [
              "",
              "IF ( COUNTROWS ( 'REF Snapshots' ) <> 1, \"Red\", \"White\" )"
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "612ca25a-1219-4819-b5eb-f15ee59f09b0"
          },
          {
            "name": "W6/M",
            "expression": [
              "",
              "IF ( ISBLANK ( [W6] ) = TRUE (), BLANK (), [W6] - [M] )"
            ],
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Structures",
            "lineageTag": "511a57b2-df93-4c21-a44e-1d0c8933f06a",
            "annotations": [
              {
