            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "2dfd39a7-bf82-4f24-8512-bccfcacbc80a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical hedge underlying PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Physical hedge underlying],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Physical hedge underlying] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "b3575e80-2605-41d6-94c9-ea3fabf3f36b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical Result spread PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Physical Result spread],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Physical Result spread] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "6a7860b8-b1ed-43bb-af71-9886dd55924f",
            "annotations": [
              {
                "name": "PBI_FormatHint",
