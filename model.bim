            "isHidden": true,
            "sourceColumn": "Ordinal",
            "lineageTag": "62f11f88-fb23-42c7-b6d2-ffcd1af17fa8",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
