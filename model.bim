              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ([Supply W-1] + [Sales M-1] + [Sales W-1]),",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              ") + [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1],",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure Y-1",
            "lineageTag": "249c6088-4878-4c85-a00a-9d586458fe5c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Flex max 2 Previous Year",
            "expression": [
              "CALCULATE(",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ( [Sales M-1] + [Sales W-1] + [Supply W-1] ),",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + 0.3",
              "            * CALCULATE (",
              "                [Sales M-1] + [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              ") + [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1],",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure Y-1",
            "lineageTag": "83e3edcc-c2ca-4f9f-85df-884de7dd86f2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Flex min 1 Previous Year",
            "expression": [
              "CALCULATE(",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1] + [Sales M-1] + [Sales W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              "    )+ [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1],",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure Y-1",
            "lineageTag": "b7a9f725-0420-4386-9582-93d8c3b82170",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Flex min 2 Previous Year",
            "expression": [
              "CALCULATE(",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1] + [Sales M-1] + [Sales W-1],",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            [Sales M-1] + [Sales W-1],",
              "            'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "        )",
              ") + [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1],",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure Y-1",
