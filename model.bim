        "partitions": [
          {
            "name": "Realized Periods Averages",
            "mode": "import",
            "queryGroup": "Data\\Data (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server, Database, [MultiSubnetFailover=true]),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_realized_periods_averages\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    #\"Inserted Merged Column\" = Table.AddColumn(CompaniesFiltered, \"Period\", each Text.Combine({Text.From([start_date], \"fr-FR\"), \" | \", Text.From([end_date], \"fr-FR\")}), type text),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Inserted Merged Column\",{\"Period\"}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Removed Columns\",{{\"start_date\", Order.Ascending}})",
                "",
                "in",
                "    #\"Sorted Rows\""
              ]
            }
          }
        ],
        "annotations": [
