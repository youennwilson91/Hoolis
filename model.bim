        "partitions": [
          {
            "name": "Time Spread Paper Positions",
            "mode": "import",
            "queryGroup": "Data\\Data (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_time_spread_paper_positions\"]}[Data],",
                "      CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    #\"Added Conditional Column\" = Table.AddColumn(CompaniesFiltered, \"Time Pattern\", each if [projection_type] = 0 then \"M-1\" else if [projection_type] = 1 then \"W-1\" else null, type text),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Added Conditional Column\",{{\"pricing_start_date\", type date}, {\"pricing_end_date\", type date}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"pricing_start_date\", \"Pricing Start Date\"}, {\"pricing_end_date\", \"Pricing End Date\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "changedProperties": [
          {
            "property": "IsHidden"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
