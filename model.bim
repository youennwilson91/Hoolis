          {
            "name": "0.3 x Supply W-1 Previous Year",
            "expression": [
              "CALCULATE(0.3 * [Supply W-1],",
              "    DATEADD('REF Calendar'[Date], -1, YEAR))"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure Y-1",
            "lineageTag": "cb63635b-1799-4aea-ab55-79a1564b5a23"
          },
          {
            "name": "Exposure Previous Year",
            "expression": [
              "CALCULATE(",
              "    IF (",
              "        2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "        // Mois réalisés",
              "        CALCULATE (",
              "            [Stocks] + [Supply M-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Realized\"",
              "        )",
              "            + CALCULATE (",
              "                0.3 * ( [Sales W-1] + [Supply W-1] ),",
              "                'REF Flow State'[Flow State] = \"Realized\"",
              "            ),",
              "        //Mois forward",
              "        CALCULATE (",
              "            [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "            'REF Flow State'[Flow State] = \"Forecasted\"",
              "        )",
              "            + CALCULATE (",
              "                [Sales M-1] + 0.3 * [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              "    ),",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure Y-1",
            "lineageTag": "ff41f4d9-57db-49b8-9e56-24c58f0e4612",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex max 1 Previous Year",
            "expression": [
              "CALCULATE(",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ([Supply W-1] + [Sales M-1] + [Sales W-1]),",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              "),",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure Y-1",
            "lineageTag": "a0ed1c1e-4904-4348-90a7-36382e30d459",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex max 2 Previous Year",
            "expression": [
              "CALCULATE(",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ( [Sales M-1] + [Sales W-1] + [Supply W-1] ),",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + 0.3",
              "            * CALCULATE (",
              "                [Sales M-1] + [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              "),",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
