          {
            "name": "P&L Value Difference",
            "expression": [
              "",
              "SWITCH (",
              "    TRUE (),",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales\", [Difference - Price Effect],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales Underlying\", [Difference - Price Effect underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales Spread\", [Difference - Price Effect spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge\", [Difference - Physical Hedge],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge Underlying\", [Difference - Physical Hedge underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge Spread\", [Difference - Physical Hedge spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result\", [Difference - Physical Result],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result Underlying\", [Difference - Physical Result underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result Spread\", [Difference - Physical Result spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge\", [Difference - Financial Hedge],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge Underlying\", [Difference - Financial hedge underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge Spread\", [Difference - Financial hedge spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure\", [Difference - Result excl. Structure],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure Underlying\", [Difference - Result excl. Structure underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure Spread\", [Difference - Result excl. Structure spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Structure\", [Difference - Structure],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Residual Price Effect\", [Difference - Residual Price Effect]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "ece8b935-fc57-4b98-b960-033839d1cf16",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "P&L Value",
            "expression": [
              "",
              "SWITCH (",
              "    TRUE (),",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales\", [Price effect],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales Underlying\", [Price effect underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Price Effect Sales Spread\", [Price effect spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge\", [Physical Hedge],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge Underlying\", [Physical Hedge underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Hedge Spread\", [Physical Hedge spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result\", [Physical Result],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result Underlying\", [Physical Result underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Physical Result Spread\", [Physical Result spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge\", [Financial Hedge],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge Underlying\", [Financial hedge underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Financial Hedge Spread\", [Financial hedge spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure\", [Result excl. Structure],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure Underlying\", [Result excl. Structure underlying],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Result excl. Structure Spread\", [Result excl. Structure spread],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Structure\", [Structure],",
              "    SELECTEDVALUE ( 'P&L Seletor'[Value] ) = \"Residual Price Effect\", [Residual Price Effect]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
