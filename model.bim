            ]
          },
          {
            "name": "W5/M",
            "expression": [
              "",
              "IF ( ISBLANK ( [W5] ) = TRUE (), BLANK (), [W5] - [M] )"
            ],
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Structures",
            "lineageTag": "0efb25d0-cda2-49b0-a905-903e6ab53c44",
            "annotations": [
