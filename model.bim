          {
            "name": "% Performance paper",
            "expression": [
              "",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _maxsnapshotvalue =",
              "    CALCULATE (",
              "        [Spread Qty],",
              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "VAR _result =",
              "    DIVIDE ( [Diff selected snapshots paper], _maxsnapshotvalue, BLANK () )",
              "RETURN",
              "    IF ( _result <> 0, _result, BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "c896e859-7fcb-49b5-ba25-1fc22f9a7281"
          },
          {
            "name": "Diff selected snapshots paper",
            "expression": [
              "",
              "--takes the latest snapshot from a selection and compares its with the other selected snapshots",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _calculate =",
              "    CALCULATE (",
              "        [Spread Qty],",
              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "RETURN",
              "    IF (",
              "        ROUND ( _calculate - [Spread Qty], 0 ) <> 0,",
              "        ROUND ( _calculate - [Spread Qty], 0 ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "6e2da9a0-963a-4e21-8820-41326559c7b8",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Hedging Simulation",
            "expression": [
              "",
              "SUM ( 'Teap Hedging Simulation'[quantity] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "7cc5d1cc-8dbd-4726-9e97-73544a776940",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Bid-Ask ($/t)",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Hedging Simulation] ),",
              "    BLANK (),",
              "    VAR _abs =",
              "        SUMMARIZE (",
              "            'Teap Hedging Simulation',",
              "            'REF Calendar'[reference_month],",
              "            'Teap Hedging Simulation'[paper_quotation_index_id],",
              "            \"hedging\", ABS ( [Hedging Simulation] )",
              "        )",
              "    RETURN",
              "        [Bid-Ask (k$)] * 1000",
              "            / SUMX ( _abs, [hedging] ) -- diviser par la somme de la valeur absolue",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "41188383-394d-4193-ba26-b414582a740b"
          },
          {
            "name": "Bid-Ask (k$)",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Hedging Simulation] ),",
              "    BLANK (),",
              "    VAR _sum =",
              "        SUMMARIZE (",
              "            'Teap Hedging Simulation',",
              "            'REF Calendar'[reference_month],",
              "            'REF Paper Index'[very_short_name],",
              "            \"value\", ABS ( [Hedging Simulation] ) * AVERAGE ( 'Bid Ask'[bid_ask] )",
              "        )",
              "    RETURN",
              "        SUMX ( _sum, [value] )",
              ") / 1000"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "d9e34267-599c-4a38-b379-874c6606867b"
          },
          {
            "name": "Difference - Sales",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Sales], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Sales], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Sales],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "f1beab23-8f5d-4010-8c7d-fa187112ed5a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
