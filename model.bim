        "partitions": [
          {
            "name": "REF Companies-7b03afe9-662f-4b51-83f8-3c2bdbbb2530",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    dbo_companies = Source{[Schema=\"dbo\",Item=\"pbi_companies\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then dbo_companies else Table.SelectRows(dbo_companies, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    Renamed = Table.RenameColumns(CompaniesFiltered,{{\"company_code\", \"Company Code\"}, {\"company_name\", \"Company Name\"}})",
                "    ",
                "in",
                "  Renamed"
              ]
            }
          }
        ],
        "annotations": [
