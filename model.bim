          {
            "name": "AVG Forward BOM",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Forward Periods Averages'[balance_of_month_average] ),",
              "    USERELATIONSHIP ( 'REF Snapshots'[Reference Date], 'Forward Periods Averages'[reference_date] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "49f98415-35d3-4532-8882-3fec888dac9a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG Last Quote",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Forward Periods Averages'[last_quote_average] ),",
              "    USERELATIONSHIP ( 'REF Snapshots'[Reference Date], 'Forward Periods Averages'[reference_date] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "ba301e40-d2c6-4f59-b706-2a9af6d3a70c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG Quotation value",
            "expression": [
              "",
              "VAR _fwd =",
              "    IF (",
              "        ISCROSSFILTERED ( 'Σ Simulations'[Simulation] ),",
              "        SWITCH (",
              "            TRUE (),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"BOM\", [AVG Forward BOM],",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"LAST QUOTE\",",
              "                IF (",
              "                    ISBLANK ( [AVG Last Quote] ) = TRUE (),",
              "                    [AVG Forward BOM],",
              "                    [AVG Last Quote]",
              "                ),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"ADDITION\", IF ( ISBLANK ( [AVG ε plus] ) = TRUE (), [AVG Forward BOM], [AVG ε plus] ),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"SUBTRACTION\", IF ( ISBLANK ( [AVG ε minus] ) = TRUE (), [AVG Forward BOM], [AVG ε minus] )",
              "        ),",
              "        [AVG Forward BOM]",
              "    )",
              "VAR _fallback =",
              "    IF ( ISBLANK ( _fwd ), [AVG Realized BOM], _fwd )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        [selected month] = \"(current)\", _fallback,",
              "        [selected month] = \"(realised)\", [AVG Realized BOM],",
              "        [selected month] = \"(forward)\", _fallback",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "bd6d09b0-a298-4637-a4e3-2d447ecceabc",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG Realized BOM",
            "expression": [
              "",
              "AVERAGE ( 'Realized Periods Averages'[balance_of_month_average] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "fee27202-34c5-4ce8-8e92-ca5d504a5d1c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG ε minus",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Forward Periods Averages'[epsilon_substraction_average] ),",
              "    USERELATIONSHIP ( 'REF Snapshots'[Reference Date], 'Forward Periods Averages'[reference_date] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "22ad960a-d27b-4a8c-846d-866bc51c90bc",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG ε plus",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Forward Periods Averages'[epsilon_addition_average] ),",
              "    USERELATIONSHIP ( 'REF Snapshots'[Reference Date], 'Forward Periods Averages'[reference_date] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Averages",
            "lineageTag": "fc42b60a-72eb-491a-b063-ab6c08d8807c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Committed Qty",
            "expression": [
              "",
              "IF (",
              "    [One Selected Snapshot],",
              "    SUM ( 'Teap Snapshot Entity Month Quantities'[committed_quantity] ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Spread",
            "lineageTag": "806b688b-1e3d-468e-9f0e-21c2cc538192",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Spread After Order",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Snapshots'[Imported On] )",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( 'Time Spread Paper Positions'[quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        'Time Spread Paper Positions'[snapshot_import_creation_date] <= _date",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Spread",
            "lineageTag": "f598c8e6-6537-4137-af89-04450290fa32",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Spread Before Order",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Snapshots'[Imported On] )",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( 'Time Spread Paper Positions'[quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        'Time Spread Paper Positions'[snapshot_import_creation_date] < _date",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Spread",
            "lineageTag": "7f5e5c15-79c8-4727-be1b-af75b2f74c5a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Spread Qty",
            "expression": [
              "",
              "IF (",
              "    SELECTEDVALUE ( 'Before/After Order'[Before/After Order] ) = \"Before Order\",",
              "    [Spread Before Order],",
              "    [Spread After Order]",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Spread",
            "lineageTag": "08b5bcd9-fae3-478f-803f-e06c97733fa7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "M+1 display",
            "expression": [
              "",
              "\"Selected month: \" & FORMAT ( MAX ( 'REF Calendar'[Month MM/AA] ), \"mmmm\" ) & \" (M+1)\""
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "ce9faff1-efba-41c7-ad49-2857a310737b"
          },
          {
            "name": "M+2 display",
            "expression": [
              "",
              "\"Selected month: \" & FORMAT ( MAX ( 'REF Calendar'[Month MM/AA] ), \"mmmm\" ) & \" (M+2)\""
            ],
            "displayFolder": "Labels & displays",
            "lineageTag": "3b797578-3e26-425b-be54-468509e80388"
          },
          {
            "name": "M-1 display",
            "expression": [
              "",
              "\"Selected month: \" & FORMAT ( MAX ( 'REF Calendar'[Month MM/AA] ), \"mmmm\" ) & \" (M-1)\""
            ],
