      {
        "name": "BASE CompaniesCompanyId",
        "isHidden": true,
        "lineageTag": "4e2ce26f-0db2-4b6a-b971-b9e523f2d377",
        "columns": [
          {
            "name": "BASE CompaniesCompanyId",
            "dataType": "string",
            "sourceColumn": "BASE CompaniesCompanyId",
            "lineageTag": "08de1016-0112-4ce6-9565-d46baa35dc53",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "BASE CompaniesCompanyId-90999190-c389-4ee6-b1bb-5fc330bc703f",
            "mode": "import",
            "queryGroup": "Parameters & Queries",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Table.FromValue(CompaniesCodes),",
                "DynamicColumnList = List.Transform({",
                "    1..List.Max(",
                "      Table.AddColumn(Source, \"Custom\", each List.Count(",
                "        Text.PositionOfAny([Value], {\",\"}, Occurrence.All)",
                "      ))[Custom]",
                "    ) + 1",
                "  }, each \"Company.\"  & Text.From(_)),",
                " #\"Split Column by Delimiter\" = Table.SplitColumn(",
                "    Source, ",
                "    \"Value\", ",
                "    Splitter.SplitTextByDelimiter(\",\", QuoteStyle.Csv), ",
                "    DynamicColumnList",
                "  ),",
                "    #\"Transposed Table\" = Table.Transpose(#\"Split Column by Delimiter\"),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Transposed Table\", {\"Column1\"}, #\"BASE CompaniesFullList\", {\"company_code\"}, \"CompaniesFullList\", JoinKind.Inner),",
                "    #\"Expanded Companies\" = Table.ExpandTableColumn(#\"Merged Queries\", \"CompaniesFullList\", {\"company_id\"}, {\"Companies.Company Id\"}),",
                "    #\"Companies Company Id1\" = #\"Expanded Companies\"[Companies.Company Id]",
                "",
                "in",
                "  #\"Companies Company Id1\""
              ]
            }
          }
        ],
        "changedProperties": [
          {
            "property": "IsHidden"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "List"
          }
        ]
      },
