                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Spread Qty Pattern W-1",
            "expression": "CALCULATE([Spread Qty], 'Time Spread Paper Positions'[Time Pattern] = \"W-1\")",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité",
            "lineageTag": "07301b6a-8b1a-42a0-8c2e-660d60050649",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Price efffe spread PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Price effect spread],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Price effect spread] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "b35d0001-3f83-40de-a91a-6128c01ff78a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Price effect underlying PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Price effect underlying],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Price effect underlying] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "024832cc-a54b-4024-a541-19657beb2fb5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
