            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"M\"",
              ")"
            ],
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "867e6396-c77d-4901-b916-79b37de360e1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
