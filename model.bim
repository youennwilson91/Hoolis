            ]
          },
          {
            "name": "Diff. M/M+6",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M] ) || ISBLANK ( [Full M+6 maturity] ),",
              "    BLANK (),",
              "    [Full M] - [Full M+6 maturity]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
