        "partitions": [
          {
            "name": "Realized Quotations",
            "mode": "import",
            "queryGroup": "Data\\Data (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    sqlQuery = ",
                "    \"",
                "    SELECT rq.[pricing_quotation_index_id]",
                "      ,rq.[index_name]",
                "      ,rq.[index_supplier_code]",
                "      ,rq.[is_closed_day]",
                "      ,rq.[medeco_code]",
                "      ,rq.[office_code]",
                "      ,rq.[office_name]",
                "      ,rq.[publication_date]",
                "      ,rq.[quotation_value]",
                "\t  ,pqibm.maturity_month_number",
                "  FROM [CTPC_V2].[dbo].[pbi_realized_quotations] rq",
                "  JOIN [CTPC_V2].[dbo].[pricing_quotation_indexes_by_maturities] pqibm on rq.index_supplier_code = pqibm.invariant_id",
                "    \",",
                "    Source = Sql.Database(Server, Database, [Query = sqlQuery]),",
                "    #\"Extracted Date\" = Table.TransformColumns(Source,{{\"publication_date\", DateTime.Date, type date}})",
                "",
                "    ",
                "in",
                "    #\"Extracted Date\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
