      {
        "name": "Σ Use Default Period",
        "lineageTag": "64925bf1-8795-4ca0-97b6-73b0d594762d",
        "calculationGroup": {
          "calculationItems": [
            {
              "name": "No",
              "expression": "SELECTEDMEASURE ()",
              "ordinal": 0
            },
            {
              "name": "M-1 -> M+5",
              "expression": [
                "",
                "        CALCULATE (",
                "            SELECTEDMEASURE (),",
                "            FILTER (",
                "                'REF Calendar',",
                "                'REF Calendar'[Date] >= EOMONTH ( TODAY (), -1 )",
                "                    && 'REF Calendar'[Date] <= EOMONTH ( TODAY (), 5 )",
                "            )",
                "        )",
                "    "
              ],
              "ordinal": 1
            },
            {
              "name": "This Year",
              "expression": [
                "CALCULATE (",
                "            SELECTEDMEASURE (),",
                "            FILTER ( 'REF Calendar', 'REF Calendar'[year] >= YEAR ( TODAY () ) )",
                "        )",
                "    "
              ],
              "ordinal": 3
            },
            {
              "name": "Last 12 M",
              "expression": [
                "",
                "       CALCULATE (",
                "            SELECTEDMEASURE (),",
                "            FILTER (",
                "                'REF Calendar',",
                "                'REF Calendar'[Date] >= EOMONTH ( TODAY (), -13 )",
                "                    && 'REF Calendar'[Date] <= EOMONTH ( TODAY (),0 )",
                "            )",
                "        )",
                "    "
              ],
              "ordinal": 4
            },
            {
              "name": "Next 12 M",
              "expression": [
                "--VAR AlreadyFiltered =",
                "--    CALCULATE ( ISCROSSFILTERED ( 'REF Calendar'[Date] ), ALLSELECTED () )",
                "--RETURN",
                "--    IF (",
                "--        AlreadyFiltered,",
                "--        SELECTEDMEASURE (),",
                "        CALCULATE (",
                "            SELECTEDMEASURE (),",
                "            FILTER (",
                "                'REF Calendar',",
                "                'REF Calendar'[Date] <= EOMONTH ( TODAY (), 12 )",
                "                    && 'REF Calendar'[Date] >= EOMONTH ( TODAY (),0 )",
                "            )",
                "        )",
                "  --  )"
              ],
              "ordinal": 5
            },
            {
              "name": "M-1 -> M+12",
              "expression": [
                "",
                "     CALCULATE (",
                "            SELECTEDMEASURE (),",
                "            FILTER (",
                "                'REF Calendar',",
                "                'REF Calendar'[Date] >= EOMONTH ( TODAY (), -1 )",
                "                    && 'REF Calendar'[Date] <= EOMONTH ( TODAY (), 12 )",
                "            )",
                "        )",
                "    "
              ],
              "ordinal": 2
            }
          ]
        },
        "columns": [
          {
            "name": "Use Default Period",
            "dataType": "string",
            "sourceColumn": "Name",
            "sortByColumn": "Ordinal",
            "lineageTag": "be7d4213-ee0b-45d7-bfb2-dc6ae85afeae",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Ordinal",
