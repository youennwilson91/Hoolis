        "partitions": [
          {
            "name": "REF Places-11dc7416-515c-4102-8ca8-f3a6f63b06e4",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_places\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    Renamed = Table.RenameColumns(CompaniesFiltered,{{\"place_code\", \"Place Code\"}, {\"place_name\", \"Place Name\"}, {\"place_short_name\", \"Place Short Name\"}, {\"place_pricing_area_code\", \"Place Pricing Area Code\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
