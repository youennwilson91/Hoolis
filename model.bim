            "expression": [
              "",
              "[Price effect spread] + [Physical hedge spread]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "d9a049d3-e0f4-405b-9143-38b0d2fd3b63",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Physical Result spread",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Physical Result spread],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Physical Result spread],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Physical Result spread],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "19ea9804-143e-4201-ad24-80e8690da6d4"
          },
          {
