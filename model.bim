              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Supply],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Supply] + _PIPE"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Pipe Ceps",
            "lineageTag": "400a8518-6411-4b88-8708-deec0cdd6a9a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "PPCD - % Hedged sales",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    1, [% Hedged sales PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Postion & Results\\Position Pipe Ceps Difference",
            "lineageTag": "6cc7472a-309c-46e9-877e-1c7010c4d22a"
          },
          {
            "name": "PPCD - Net Position",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Net Position PIPE CEPS],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Net Position PIPE CEPS],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Net Position PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Pipe Ceps Difference",
            "lineageTag": "eedf252a-2d52-468b-91b8-2244f56e220a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "PPCD -Sales",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Sales PIPE CEPS], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Sales PIPE CEPS], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Sales PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
