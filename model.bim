          },
          {
            "name": "Net Exposure",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + [Sales M-1],",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * ( [Sales W-1] + [Supply W-1] ),",
              "            'REF Flow State'[Flow State] = \"Realized\"",
              "        ),",
              "    //Mois forward",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            [Sales M-1] + 0.3 * [Sales W-1],",
              "            'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "        )",
              ")",
              "",
              "+ [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure",
            "lineageTag": "d1c260f7-a578-4888-b641-4a460656b29f",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Flex max 1",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ([Supply W-1] + [Sales M-1] + [Sales W-1]),",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              ")",
              "",
              "+ [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Net Exposure",
            "lineageTag": "f9daa7bb-fd72-439e-972f-a597becbb2cb",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Net Flex max 2",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ( [Sales M-1] + [Sales W-1] + [Supply W-1] ),",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + 0.3",
              "            * CALCULATE (",
              "                [Sales M-1] + [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              ")",
              "",
              "+ [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1]"
            ],
            "formatString": "#,##0",
