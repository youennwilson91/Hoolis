              }
            ]
          },
          {
            "name": "Supply M-1",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] = \"SUPPLY M-1\",",
              "    all('REF Flow State'),",
              "    ALL('Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern])",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "508697da-66ee-4fdd-9f59-fe1d2545ef98",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Supply W-1",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] = \"SUPPLY W-1\",",
              "    all('REF Flow State'),",
              "    ALL('Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern])",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "cd68f4fc-735f-4b70-b8e5-5da2c50f1077",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Supply M",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] = \"SUPPLY M\",",
              "    all('REF Flow State'),",
              "    ALL('Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern])",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "000c998f-d0c0-4015-8da6-d6fa78d3e99a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Stocks M+1",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'REF Operation Categories'[Op. Cat. Code] = \"STOCK\",",
              "    'REF Month Periods'[month_period_name] = \"M\",",
              "    DATEADD ( 'Teap Snapshot Entity Month Quantities'[month/year], 1, MONTH ),",
              "    ALL ( 'REF Calendar' ),",
              "    ALL ( 'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "5daf34bb-055f-438a-ace2-09058193b0e3",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Discrepancy",
            "expression": [
              "",
              "[Supply] + [Sales] - [Stocks M+1] + [Stocks]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "eabfd5e7-6ddb-446a-8ac7-7de60f73f87c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Exposure",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + [Sales M-1],",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * ( [Sales W-1] + [Supply W-1] ),",
              "            'REF Flow State'[Flow State] = \"Realized\"",
              "        ),",
              "    //Mois forward",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            [Sales M-1] + 0.3 * [Sales W-1],",
              "            'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "        )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure",
            "lineageTag": "89475154-78d6-4198-976d-4f7c09c7df9c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex max 1",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ([Supply W-1] + [Sales M-1] + [Sales W-1]),",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure",
            "lineageTag": "a0ce4664-c4c6-45f8-ba7a-a0e37f4027d0",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex min 2",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1] + [Sales M-1] + [Sales W-1],",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            [Sales M-1] + [Sales W-1],",
              "            'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "        )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure",
            "lineageTag": "e80866ed-dec7-4d09-bbb6-89ec10535d21",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex max 2",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés : ",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * ( [Sales M-1] + [Sales W-1] + [Supply W-1] ),",
              "        'REF Flow State'[Flow State] = \"Realized\"",
              "    ),",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + 0.3",
              "            * CALCULATE (",
              "                [Sales M-1] + [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure",
            "lineageTag": "e12d5fbb-74bf-4fdf-899a-7b503f979828",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Flex min 1",
            "expression": [
              "",
              "IF (",
              "    2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "    // Mois réalisés",
              "    [Exposure],",
              "    // Mois non réalisés :",
              "    CALCULATE (",
              "        [Stocks] + [Supply M-1] + 0.3 * [Supply W-1] + [Sales M-1] + [Sales W-1],",
              "        'REF Flow State'[Flow State] = \"Forecasted\"",
              "    )",
              "        + CALCULATE (",
              "            0.3 * [Sales W-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Committed\"",
              "        )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité\\Exposure",
            "lineageTag": "5909bd5c-4ae6-4fbb-beef-1210622a8ac6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "AVG Realized Quotation Value",
            "expression": [
              "",
              "IF (",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] ) = 0",
              "        || ISBLANK ( AVERAGE ( 'Realized Quotations'[quotation_value] ) ),",
              "    BLANK (),",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] )",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Average Quotations & Stuctures",
            "lineageTag": "0fc825dd-41d8-4e54-8e9d-aedc73c621e1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Full M+2",
            "expression": [
              "VAR _date = SELECTEDVALUE('REF Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    AVERAGE('Forward Periods Averages'[balance_of_month_average]),",
              "    ALL('REF Calendar'),",
              "    'REF Month Periods'[month_period_name] = \"M\",",
              "    'Forward Periods Averages'[reference_date] = _date,",
              "    DATEADD('REF Month Periods'[month], 2, MONTH)",
              ")",
              ""
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "3f63014e-0f8c-4192-b615-c809506119b8",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Realized Qty",
            "expression": [
              "",
              "IF (",
              "    [One Selected Snapshot],",
              "    SUM ( 'Teap Snapshot Entity Month Quantities'[realized_quantity] ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "319f7c39-bb7b-4741-a2a7-e714c6be5bbf",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Forecast Qty",
            "expression": [
              "",
              "IF (",
              "    [One Selected Snapshot],",
              "    SUM ( 'Teap Snapshot Entity Month Quantities'[forecast_quantity] ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Real vs Forecast",
            "lineageTag": "add6d377-957c-4a52-aa6f-fe8a9315b158",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. M+1/M+2",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M+1] ) || ISBLANK ( [Full M+2] ),",
              "    BLANK (),",
              "    [Full M+1] - [Full M+2]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "ff72033f-878b-41e8-8197-c37490332cfb",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Index ID",
            "expression": [
              "",
              "SWITCH (",
              "    TRUE (),",
              "    SELECTEDVALUE ( 'REF PRI'[invariant_id] ) = \"PJAAU00H\" || SELECTEDVALUE ( 'REF PRI'[invariant_id] ) = \"AAIDL00H\", \"KCCNW-H\",",
              "    SELECTEDVALUE ( 'REF PRI'[invariant_id] ) = \"PJABA00H\", \"KBFNW-H\",",
              "    SELECTEDVALUE ( 'REF PRI'[invariant_id] ) = \"LGE1C2C1\", \"GO\"",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "37337c12-d827-40f1-bd6f-b89189958686"
          },
          {
            "name": "Full M",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGE ( 'Forward Periods Averages'[balance_of_month_average] ),",
              "        'REF Month Periods'[month_period_name] = \"M\",",
              "        'Forward Periods Averages'[reference_date] = _date,",
              "        'Forward Periods Averages'[balance_of_month_average] <> 0",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "831aebc5-5abb-45ac-a810-487ac00b8018",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical Result underlying",
            "expression": [
              "",
              "[Price effect underlying] + [Physical hedge underlying]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "92226725-cdd8-490a-99a4-0b93b238b05c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical hedge underlying",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Teap Snapshot Entity Month Quantities',",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF PRI'[very_short_name],",
              "        'Teap Snapshot Entity Month Quantities'[Week Pattern]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"s&s\", [Stocks & Supply],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF PRI'[invariant_id] = \"PJAAU00H\",",
              "                // Filtre sur l'indice JET CIF NWE",
              "                USERELATIONSHIP ( 'Teap Snapshot Entity Month Quantities'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF PRI'[invariant_id] = \"PJAAU00H\" // Filtre sur l'indice JET CIF NWE",
              "            )",
              "    )",
              "RETURN",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [s&s] ) / 1000"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "0d69b49c-60a8-4465-82ce-abc43e5d0cb5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Price effect underlying",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Teap Snapshot Entity Month Quantities',",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF PRI'[very_short_name],",
              "        'Teap Snapshot Entity Month Quantities'[Week Pattern]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"sales\", [Sales],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF PRI'[invariant_id] = \"PJAAU00H\",",
              "                // Filtre sur JET CIF NWE",
              "                USERELATIONSHIP ( 'Teap Snapshot Entity Month Quantities'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF PRI'[invariant_id] = \"PJAAU00H\" // Filtre sur JET CIF NWE",
              "            )",
              "    )",
              "RETURN",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [sales] ) / 1000"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "db15f0ed-6fd3-405d-8e7e-95701dd0566a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
