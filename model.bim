          {
            "name": "Stocks Previous Year",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'REF Operation Categories'[Op. Cat. Code] = \"STOCK\",",
              "    DATEADD('REF Calendar'[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply\\Y-1",
            "lineageTag": "9179909d-742b-4300-967c-8707a1e5129c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Period panel 1 display",
            "expression": [
              "",
              "var _bornemin = CALCULATE(SELECTEDVALUE('REF Calendar'[reference_month]), DATEADD('REF Calendar'[Date], -1, month))",
              "var _bornemax = CALCULATE(SELECTEDVALUE('REF Calendar'[Date]), DATEADD('REF Calendar'[Date], +1, month), day('REF Calendar'[Date]) = 20)",
              "RETURN",
              "FORMAT(_bornemin, \"dd/mm/yyyy\") & \" - \" & FORMAT(_bornemax, \"dd/mm/yyyy\")"
            ],
            "displayFolder": "Volume Effects",
            "lineageTag": "c247bb8b-b854-43f6-9633-69c02aa7498d"
          },
          {
            "name": "Period panel 2 display",
            "expression": [
              "",
              "var _bornemin = CALCULATE(SELECTEDVALUE('REF Month Periods'[pricing_start_date]), 'REF Month Periods'[month_period_name] = \"W1\")",
              "var _bornemax = CALCULATE(SELECTEDVALUE('REF Calendar'[Date]), DATEADD('REF Calendar'[Date], +1, month), day('REF Calendar'[Date]) = 20)",
              "RETURN",
              "FORMAT(_bornemin, \"dd/mm/yyyy\") & \" - \" & FORMAT(_bornemax, \"dd/mm/yyyy\")"
            ],
            "displayFolder": "Volume Effects",
            "lineageTag": "464e06fa-ee24-4a26-be5a-fe9d84a5cde7"
          },
          {
            "name": "Snapshot panel 1",
            "expression": [
              "",
              "var _bornemin = CALCULATE(SELECTEDVALUE('REF Calendar'[reference_month]), DATEADD('REF Calendar'[Date], -1, month))",
              "var _bornemax = CALCULATE(SELECTEDVALUE('REF Calendar'[Date]), DATEADD('REF Calendar'[Date], +1, month), day('REF Calendar'[Date]) = 20)",
              "var _maxsnapshot = CALCULATE(max('REF Snapshots'[Snapshot Id]), ALL('REF Snapshots'), 'REF Snapshots'[Reference Date] < _bornemin, 'REF Snapshots'[Snapshot State] = \"Validated\")",
              "var _row = ROW(\"Snapshot Id\", _maxsnapshot)",
              "var _panel = ",
              "UNION(",
              "    CALCULATETABLE(SELECTCOLUMNS('REF Snapshots', 'REF Snapshots'[Snapshot Id]), 'REF Snapshots'[Reference Date] <= _bornemax && 'REF Snapshots'[Reference Date] >= _bornemin),",
              "    _row",
              ")",
              "RETURN",
              "if(SELECTEDVALUE('REF Snapshots'[Snapshot Id]) in _panel, 1, 0)",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Volume Effects",
            "lineageTag": "1e1a0023-96b4-448c-a99f-0d5e7656a460"
          },
          {
            "name": "Snapshot panel 2",
            "expression": [
              "",
              "var _bornemin = CALCULATE(SELECTEDVALUE('REF Month Periods'[pricing_start_date]), 'REF Month Periods'[month_period_name] = \"W1\")",
              "var _bornemax = CALCULATE(SELECTEDVALUE('REF Calendar'[Date]), DATEADD('REF Calendar'[Date], +1, month), day('REF Calendar'[Date]) = 20)",
              "var _maxsnapshot = CALCULATE(max('REF Snapshots'[Snapshot Id]), ALL('REF Snapshots'), 'REF Snapshots'[Reference Date] < _bornemin, 'REF Snapshots'[Snapshot State] = \"Validated\")",
              "var _row = ROW(\"Snapshot Id\", _maxsnapshot)",
              "var _panel = ",
              "UNION(",
              "    CALCULATETABLE(SELECTCOLUMNS('REF Snapshots', 'REF Snapshots'[Snapshot Id]), 'REF Snapshots'[Reference Date] <= _bornemax && 'REF Snapshots'[Reference Date] >= _bornemin),",
              "    _row",
              ")",
              "RETURN",
              "if(SELECTEDVALUE('REF Snapshots'[Snapshot Id]) in _panel, 1, 0)",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Volume Effects",
            "lineageTag": "a2551d55-7934-4780-b84e-588f817d844f"
          },
          {
            "name": "% Performance M-2",
            "expression": [
              "",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _maxsnapshotvalue =",
              "    CALCULATE (",
              "        SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        DATEADD('REF Calendar'[Date], -2, MONTH),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "VAR _result =",
              "    DIVIDE ( CALCULATE([Diff selected snapshots], DATEADD('REF Calendar'[Date], -2, MONTH)), _maxsnapshotvalue, BLANK () )",
              "RETURN",
              "    IF ( _result <> 0, _result, BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Volume Effects\\M-2",
            "lineageTag": "ff898201-9a9a-4990-b630-d0624f5e7469"
          },
          {
            "name": "% Performance M-1",
            "expression": [
              "",
              "",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _maxsnapshotvalue =",
              "    CALCULATE (",
              "        SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        DATEADD('REF Calendar'[Date], -1, MONTH),",
              "        'REF Snapshots'[Snapshot Id] = _max",
              "    )",
              "VAR _result =",
              "    DIVIDE ( CALCULATE([Diff selected snapshots], DATEADD('REF Calendar'[Date], -1, MONTH)), _maxsnapshotvalue, BLANK () )",
              "RETURN",
              "    IF ( _result <> 0, _result, BLANK () )"
            ],
            "displayFolder": "Volume Effects\\M-1",
            "lineageTag": "2421a977-ada6-414b-95d3-a1e82eeb6a24",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff selected snapshots M-1",
            "expression": [
              "",
              "--takes the latest snapshot from a selection and compares its with the other selected snapshots",
              "VAR _max =",
              "    MAXX ( ALLSELECTED ( 'REF Snapshots' ), [Snapshot Id] )",
              "VAR _calculate =",
              "    CALCULATE (",
              "        SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ),",
              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max,",
              "        DATEADD('REF Calendar'[Date], -1, MONTH)",
              "    )",
              "RETURN",
              "    IF (",
              "        ROUND (",
              "            _calculate - CALCULATE(SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ), DATEADD('REF Calendar'[Date], -1, MONTH)),",
              "            0            ",
              "        ) <> 0,          ",
              "        ROUND (          ",
              "            _calculate - CALCULATE(SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ), DATEADD('REF Calendar'[Date], -1, MONTH)),",
              "            0",
              "        ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Volume Effects\\M-1",
            "lineageTag": "14425e80-d9c6-4523-a225-be34e63faad0",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
