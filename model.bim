        ],
        "partitions": [
          {
            "name": "REF Entities-d684c83d-efe7-4cb6-a90f-fc2ff2d4256f",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    //Source = Sql.Database(\"georges\", \"CTPC_preprod_V2\"),",
                "    //dbo_entities = Source{[Schema=\"dbo\",Item=\"pbi_entities\"]}[Data],",
                "     //CompaniesFiltered = if (CompaniesCodes = \"ALL\") then dbo_entities else Table.SelectRows(dbo_entities, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    //Renamed = Table.RenameColumns(CompaniesFiltered,{{\"entity_code\", \"Entity Code\"}, {\"entity_name\", \"Entity Name\"}})",
                "    sqlQuery = ",
                "    \"",
                "    SELECT",
                "\te.entity_id,",
                "\te.invariant_id,",
                "\te.name,",
                "    e.display_order,",
                "\tu.invariant_id as unit",
                "\t",
                "    FROM",
                "\tentities e",
                "\tJOIN companies c\tON c.company_id = e.company_id",
                "",
                "\tJOIN teap_entities_units eu\t\tON eu.entity_id = e.entity_id",
                "\tJOIN units u on u.unit_id = eu.unit_id",
                "\t",
                "    where c.invariant_id = 'TEAP'",
                "",
                "",
                "        \",",
                "    Source = Sql.Database(Server,Database,[Query=sqlQuery, CommandTimeout=#duration(0, 0, 5, 0)]),",
                "    #\"Colonnes renommées\" = Table.RenameColumns(Source,{{\"name\", \"Entity Name\"}, {\"unit\", \"Unit\"}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Colonnes renommées\", each ([Unit] = \"TO\")),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Filtered Rows\",{{\"display_order\", \"Display Order\"}})",
                "",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
