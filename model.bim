            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "527d4738-1b97-4241-bfc5-a431782677bd"
          },
          {
            "name": "W4 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W4\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "fc91cc2a-d275-4a6f-a1ab-e9555e0652fe"
          },
          {
            "name": "W5 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W5\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "1f4c9ee5-4bee-46b8-92e6-04c0daef2790"
          },
          {
            "name": "W6 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W6\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "aa39ef76-fba0-4115-9533-d9644517c18a"
          },
          {
            "name": "(W-1/M) / (M-1/M) RD",
            "expression": [
              "",
              "DIVIDE ( [W-1/M RD], [M-1/M RD], BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Structures",
            "lineageTag": "8c9d9349-1462-4d47-947d-f3b5fab56586"
          },
          {
