          {
            "name": "Physical Result",
            "expression": [
              "",
              "[Price effect] + [Physical hedge]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "26917136-0959-4fda-a1ce-7de6c2d690e4",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Result excl. Structure",
            "expression": [
              "",
              "[Physical Result] + [Financial Hedge]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "c2a782d1-5654-43b9-acb7-7b5ad848e0e9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Difference - Physical Result",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Physical Result], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Physical Result], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Physical Result],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "8a6e6212-9507-4801-abb7-1ca00c7647c3",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Result excl. Structure",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Result excl. Structure],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Result excl. Structure],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Result excl. Structure],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "dbc5f19c-5fb1-4047-823f-8da1dd1a102b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Result excl. Structure PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Result excl. Structure],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Result excl. Structure] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "7a8ac200-3a1e-402e-b2f4-e39c31554e9a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
