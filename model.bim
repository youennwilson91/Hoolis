            ]
          },
          {
            "name": "Spread Qty PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Spread Qty],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Spread Qty] + _PIPE"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Pipe Ceps",
            "lineageTag": "89d2e6c5-4477-4062-a75e-47fdb04f8b1a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Structure Realized Quotations",
            "expression": [
              "",
              "VAR _m =",
              "    SELECTEDVALUE ( 'Realized Quotations'[maturity_month_number] )",
              "VAR _m1 =",
              "    IF ( _m = 0, 0, _m - 1 )",
              "RETURN",
              "    CALCULATE (",
              "        [AVG Realized Quotation Value],",
              "        'Realized Quotations'[maturity_month_number] = _m1",
              "    ) - [AVG Realized Quotation Value]"
            ],
            "displayFolder": "Dashboard Quotations\\Average Quotations & Stuctures",
            "lineageTag": "29f58442-7bdb-4a54-ac99-2d37e0eff8d2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "AVG Cumulated structure",
            "expression": [
              "",
              "VAR _count =",
              "    COUNT ( 'Realized Quotations'[publication_date] )",
              "VAR _maturity =",
              "    SELECTEDVALUE ( 'Realized Quotations'[maturity_month_number] )",
              "VAR A =",
              "    CALCULATETABLE (",
              "        SUMMARIZE (",
              "            'Realized Quotations',",
              "            'Realized Quotations'[maturity_month_number]",
              "        ),",
              "        'Realized Quotations'[maturity_month_number] <= _maturity,",
              "        'Realized Quotations'[maturity_month_number] >= 2",
              "    )",
              "RETURN",
              "    SUMX ( A, [Structure Realized Quotations] / ( _maturity - 1 ) )"
            ],
            "displayFolder": "Dashboard Quotations\\Average Quotations & Stuctures",
            "lineageTag": "2d1ae741-3062-44ac-a85c-36b4cc86abca",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Structure",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Snapshots'[Imported On] )",
              "VAR _bo =",
              "    CALCULATE (",
              "        SUM ( 'Time Spread Paper Positions'[structure] ) / 1000,",
              "        ALL ( 'REF Snapshots' ),",
              "        'Time Spread Paper Positions'[snapshot_import_creation_date] < _date",
              "    )",
              "VAR _ao =",
              "    CALCULATE (",
              "        SUM ( 'Time Spread Paper Positions'[structure] ) / 1000,",
              "        ALL ( 'REF Snapshots' ),",
              "        'Time Spread Paper Positions'[snapshot_import_creation_date] <= _date",
              "    )",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Before/After Order'[Before/After Order] ) = \"Before Order\",",
              "        _bo,",
              "        _ao",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "b77863e1-ecb3-4a9f-999c-66324fb6c983"
          },
          {
            "name": "Structure simulated ($/t)",
            "expression": [
              "",
              "DIVIDE ( [Structure], [Hedging Simulation], BLANK () ) * 1000"
            ],
            "formatString": "0.00",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "daf6c4b4-c31a-4e2b-9a0f-3ded47a4dd8a"
          },
          {
            "name": "Forward structure incl. Bid-Ask (k$)",
            "expression": [
              "",
              "SUMX (",
              "    'REF Projection Type',",
              "    [Forward structure excl. Bid-Ask (k$)] - [Bid-Ask (k$)]",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "ff3b787c-f995-4b26-954a-258580dbb9e3"
          },
          {
            "name": "Forward structure incl. Bid-Ask ($/t)",
            "expression": [
              "",
              "SUMX (",
              "    'REF Projection Type',",
              "    DIVIDE (",
              "        [Forward structure incl. Bid-Ask (k$)],",
              "        [Hedging Simulation],",
              "        BLANK ()",
              "    ) * 1000",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "797ebf5a-252c-4ea4-9fee-b4a9eaf24a5f"
          },
          {
            "name": "Forward structure excl. Bid-Ask (k$)",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Hedging Simulation] ),",
              "    BLANK (),",
              "    VAR _sum =",
              "        SUMMARIZE (",
              "            'REF Month Periods',",
              "            'REF Month Periods'[month],",
              "            'REF Month Periods'[month_period_name],",
              "            \"AVG W\", [AVG Quotation value],",
              "            \"AVG M\",",
              "                CALCULATE (",
              "                    [AVG Quotation value],",
              "                    'REF Month Periods'[month_period_name] = \"M\",",
              "                    ALLEXCEPT ( 'REF Month Periods', 'REF Month Periods'[month] )",
              "                ),",
              "            \"hedging\",",
              "                CALCULATE (",
              "                    [Hedging Simulation],",
              "                    USERELATIONSHIP ( 'REF Month Periods'[Key_QTY], 'Teap Hedging Simulation'[Key_QTY] )",
              "                )",
              "        )",
              "    RETURN",
              "        SUMX ( _sum, ( [AVG W] - [AVG M] ) * [hedging] ) / 1000",
              ")",
              "",
              "",
              "",
              "",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "b4e3533d-2532-4f09-b05d-e78159c6c18e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Forward structure excl. Bid-Ask ($/t)",
            "expression": [
              "",
              "[Forward structure excl. Bid-Ask (k$)] / [Hedging Simulation] * 1000"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Postion & Results\\Simulation",
            "lineageTag": "067a59af-f3fb-48cc-a0e2-ca20a3a8538e"
          },
          {
            "name": "Stocks (ALL Flow State)",
            "expression": [
              "",
              "CALCULATE (",
              "    [Stocks],",
              "    ALL ( 'REF Flow State' ),",
              "    ALL ( 'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Stocks & Supply",
            "lineageTag": "240f2c9a-42b0-42a9-bdfb-922ffd661598",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Sales + Supply (ALL Flow State)",
            "expression": [
              "",
              "VAR _sales =",
              "    IF (",
              "        [One Selected Snapshot]",
              "            && SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ) <> 0,",
              "        [Sales],",
              "        BLANK ()",
              "    )",
              "VAR _supply =",
              "    CALCULATE ( [Supply], ALL ( 'REF Flow State' ) )",
              "RETURN",
              "    _sales + _supply"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Sales",
            "lineageTag": "35d4095c-812b-4bbc-bf53-e0cbb956d79a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Value quotations",
            "expression": [
              "",
              "VAR _date =",
              "    CALCULATE (",
              "        LASTDATE ( 'Company Pricing Quotation Forwards'[reference_date] ),",
              "        ALLEXCEPT (",
              "            'Company Pricing Quotation Forwards',",
              "            'Company Pricing Quotation Forwards'[pricing_quotation_index_id]",
              "        )",
              "    )",
              "VAR _fwd =",
              "    CALCULATE (",
              "        SUM ( 'Company Pricing Quotation Forwards'[balance_of_month] ),",
              "        'Company Pricing Quotation Forwards'[reference_date] = _date",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _fwd ) = TRUE (),",
              "        SUM ( 'Realized Quotations'[quotation_value] ),",
              "        _fwd",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Others",
            "lineageTag": "3a4b306a-b739-4bbc-aad7-a055cfb9928b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Sales M-1 Forecasted",
