        "partitions": [
          {
            "name": "REF Calendar-b578e65a-2cf8-4144-9fa2-22b9a3d7c61d",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Not Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    calendars =  Source{[Schema = \"dbo\", Item = \"pbi_Calendar\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(calendars,{{\"reference_date\", type date}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"aviation_week_physical\", \"Aviation Week - Physical\"}, {\"fortnight\", \"Fortnight\"}, {\"moroccan_fortnight_physical\", \"Moroccan Fortnight - Physical\"}, {\"moroccan_fortnight_pricing\", \"Moroccan Fortnight - Pricing\"}, {\"senegalese_moon_physical\", \"Senegalese Moon - Physical\"}, {\"senegalese_moon_pricing\", \"Senegalese Moon - Pricing\"}, {\"week\", \"Week\"}, {\"reference_date\", \"Date\"}, {\"month\", \"Month\"}, {\"year\", \"Year\"}, {\"quarter\", \"Quarter\"}, {\"semester\", \"Semester\"}, {\"ten_day\", \"Ten Day\"}, {\"Day_Of_Week\", \"Day Of Week\"}, {\"day_of_week_en\", \"Day Of Week EN\"}, {\"day_of_year\", \"Day Of Year\"}, {\"month_name\", \"Month Name\"}, {\"month_fr\", \"Month FR\"}, {\"month_of_the_year\", \"Month Of Year\"}, {\"quarter_name\", \"Quarter Name\"}, {\"semester_name\", \"Semester Name\"}, {\"ten_day_name\", \"Ten Day Name\"}, {\"week_name\", \"Week Name\"}, {\"week_of_the_year\", \"Week Of Year\"}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Renamed Columns\", each [Date] >= #\"Date Start\"),",
                "    #\"Texte inséré après le délimiteur\" = Table.AddColumn(#\"Filtered Rows\", \"Texte après le délimiteur\", each Text.AfterDelimiter(Text.From([Date], \"fr-FR\"), \"/\"), type text),",
                "    #\"Colonnes renommées\" = Table.RenameColumns(#\"Texte inséré après le délimiteur\",{{\"Texte après le délimiteur\", \"Month/Year\"}}),",
                "    #\"Date extraite\" = Table.TransformColumns(#\"Colonnes renommées\",{{\"reference_month\", DateTime.Date, type date}}),",
                "    #\"Colonne conditionnelle ajoutée\" = Table.AddColumn(#\"Date extraite\", \"Personnalisé\", each if [#\"Month/Year\"] = \"01/2020\" then \"31/2019\" else if [#\"Month/Year\"] = \"02/2020\" then \"01/2020\" else if [#\"Month/Year\"] = \"03/2020\" then \"02/2020\" else if [#\"Month/Year\"] = \"04/2020\" then \"03/2020\" else null, type text),",
                "    #\"Colonnes supprimées\" = Table.RemoveColumns(#\"Colonne conditionnelle ajoutée\",{\"Personnalisé\"}),",
                "    #\"Personnalisée ajoutée\" = Table.AddColumn(#\"Colonnes supprimées\", \"Personnalisé\", each Text.Combine(Date.Month([reference_month]),\"/\", Date.Year([reference_year]))),",
                "    #\"Duplicated Column\" = Table.AddColumn(#\"Personnalisée ajoutée\", \"Date (Both Relationship)\", each [Date], type date),",
                "    #\"Colonnes supprimées1\" = Table.RemoveColumns(#\"Duplicated Column\",{\"Personnalisé\"}),",
                "    #\"Colonnes renommées1\" = Table.RenameColumns(#\"Colonnes supprimées1\",{\"Month/Year\", \"Reference Month\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Colonnes renommées1\",{{\"Reference Month\", \"Month MM/AA\"}}),",
                "    #\"AddPreviousYear\" = Table.AddColumn(#\"Renamed Columns1\", \"Month MM/AA Previous Year\", each Date.ToText(Date.AddYears([Date], -1), \"MM/yy\"), type text)",
                "in",
                "    AddPreviousYear"
              ]
            }
          }
        ],
