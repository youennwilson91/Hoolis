          {
            "name": "RPCD - Financial Hedge",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Financial hedge PIPE CEPS],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Financial hedge PIPE CEPS],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Financial hedge PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps Difference",
            "lineageTag": "df092603-ceca-4d34-808b-969cc924e1d5",
            "annotations": [
