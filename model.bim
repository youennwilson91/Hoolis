          {
            "name": "Full M+2 maturity",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "VAR _pulication_date =",
              "    CALCULATE (",
              "        MAX ( 'Realized Quotations'[publication_date] ),",
              "        ALL ( 'REF Calendar' ),",
              "        'Realized Quotations'[publication_date] < _date",
              "    )",
              "VAR _invariant_id = [Index ID]",
              "VAR _index = CALCULATE(SELECTEDVALUE('REF PRI'[pricing_quotation_index_id]), ALL('REF PRI'), 'REF PRI'[invariant_id] = _invariant_id)",
              "VAR maturity =",
              "    IF ( ISBLANK ( [Priced M] ), 3, 2 )",
              "RETURN",
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] ),",
              "    ALL ( 'Realized Quotations' ),",
              "    'Realized Quotations'[publication_date] = _pulication_date,",
              "    'Realized Quotations'[maturity_month_number] = maturity,",
              "    'Realized Quotations'[pricing_quotation_index_id] = _index",
              ")",
              "",
              "",
              ""
            ],
            "displayFolder": "Dashboard Quotations\\Full M\\Maturity",
            "lineageTag": "a521ccae-ad99-4f49-980c-ab50b4e5c1c4",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. W-1/M",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M] ) || ISBLANK ( [Full W-1] ),",
              "    BLANK (),",
              "    [Full W-1] - [Full M]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "0eab3a12-f2b3-4cd3-a8c9-15e38e111530",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Full W-1",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "RETURN",
              "    IF ([calendar filtered by reference date] = 1,",
              "        VAR _summarize =",
              "            CALCULATETABLE (",
              "                SUMMARIZE (",
              "                    'REF Month Periods',",
              "                    'REF Month Periods'[month_period_name],",
              "                    'REF Month Periods'[month],",
              "                    \"value\",",
              "                        CALCULATE (",
              "                            [AVG Quotation value RD] * AVERAGE ( 'REF Month Periods'[week_weight] ),",
              "                            'Forward Periods Averages'[reference_date] = _date",
              "                        )",
              "                ),",
              "                'REF Month Periods'[month_period_name] <> \"M-1\"",
              "                    && 'REF Month Periods'[month_period_name] <> \"M\"",
              "            )",
              "        RETURN",
              "            SUMX ( _summarize, [value] ),",
              "        BLANK ()",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "650f7e3e-f021-4c43-8274-22d135595dca",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "calendar filtered by reference date",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "RETURN",
              "    IF (_date IN VALUES ( 'Forward Periods Averages'[reference_date] ), 1, 0)"
            ],
            "formatString": "0",
            "displayFolder": "Dashboard Quotations\\Others",
            "lineageTag": "80f9e228-5fe7-4359-a246-f8b0f846bdb2"
          },
