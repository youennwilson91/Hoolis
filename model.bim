        "partitions": [
          {
            "name": "DATA Aggregated Flows-2ccb8506-e5fb-48da-bbcd-76b0b87d29dd",
            "mode": "import",
            "queryGroup": "Data\\Data (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_aggregated_flows\"]}[Data],",
                " CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "     SnapshotIDs = Table.Column(#\"REF Snapshots\", \"snapshot_hidden_key\"),",
                "    SnapshotFiltered = Table.SelectRows(CompaniesFiltered, each List.Contains(SnapshotIDs,[snapshot_hidden_key] )),",
                "    #\"Renamed Columns\" = Table.RenameColumns(SnapshotFiltered,{{\"flow_id\", \"Flow Id\"}, {\"physical_date\", \"Physical Date\"}, {\"pricing_end_date\", \"Pricing End Date\"}, {\"pricing_start_date\", \"Pricing Start Date\"}, {\"auto_generated\", \"Autogenerated\"}, {\"layer\", \"Layer\"}, {\"original_flow_id\", \"Original Flow Id\"}, {\"transformed_layer\", \"Transformed Layer\"}, {\"transformed_pricing_end_date\", \"Transformed Pricing End Date\"}, {\"transformed_pricing_formula\", \"Transformed Pricing Formula\"}, {\"transformed_pricing_start_date\", \"Transformed Pricing Start Date\"}, {\"created\", \"Created\"}, {\"created_by\", \"Created By\"}, {\"description\", \"Description\"}, {\"last_modified\", \"Last Modified\"}, {\"last_modified_by\", \"Last Modified By\"}, {\"auto_generated_type\", \"Auto Generated Type\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Exception"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
