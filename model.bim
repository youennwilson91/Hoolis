            "name": "REF Formulas-96af34c7-4ca3-4c28-9151-21b4278cfba0",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_formulas\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    #\"Renamed Columns\" = Table.RenameColumns(CompaniesFiltered,{{\"formula_code\", \"Formula Code\"}, {\"formula_name\", \"Formula Name\"}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Renamed Columns\", {\"company_id\"}, #\"REF Companies\", {\"company_id\"}, \"REF Companies\", JoinKind.LeftOuter),",
                "    #\"Expanded REF Companies\" = Table.ExpandTableColumn(#\"Merged Queries\", \"REF Companies\", {\"Company Code\"}, {\"REF Companies.Company Code\"}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Expanded REF Companies\", \"Formula Time Pattern\", each if Text.Contains([Formula Code], \"_M_\") then \"M\" else if Text.Contains([Formula Code], \"_M-1_\") then \"M-1\" else if Text.Contains([Formula Code], \"_W-1_\") then \"W-1\" else null),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Added Conditional Column\",{",
                "        {\"REF Companies.Company Code\", \"Company Code\"}}",
                "        )",
                "in",
                "    #\"Renamed Columns1\""
              ]
            }
          }
        ],
