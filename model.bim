              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Structure], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Structure], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Structure],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "39fe39ff-edb3-4041-9e67-b90e2d01b325",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Residual Price Effect",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Residual Price Effect],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Residual Price Effect],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Residual Price Effect],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Difference",
            "lineageTag": "52c349fb-70fd-4ed4-a596-0fd8332c190a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Supply",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Supply], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Supply], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Supply],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "7635e074-dd5f-4778-aa1c-aa39974ea1fd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Spread Qty",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE ( [Spread Qty], 'REF Snapshots'[Snapshot Id] = _last_snapshot )",
              "                - CALCULATE ( [Spread Qty], 'REF Snapshots'[Snapshot Id] = _first_snapshot ),",
              "    1, [Spread Qty],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "d7317365-5ab8-48c8-b4b7-3af41fee3d66",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Contracted sales",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Physical Position],",
              "                'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] = 0,",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Physical Position],",
              "                    'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] = 0,",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1,",
              "        CALCULATE (",
              "            [Physical Position],",
              "            'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] = 0",
              "        ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "4b2e5549-2987-4972-8fcc-8482f57a5a97",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Contracted Net Position",
            "expression": [
              "",
              "IF (",
              "    [selected month] = \"(realised)\",",
              "    BLANK (),",
              "    CALCULATE (",
              "        [Difference - Contracted sales],",
              "        'Teap Pricing Formula Time Patterns'[Time Pattern] <> \"M\",",
              "        'Teap Pricing Formula Time Patterns'[Time Pattern] <> \"M-1\"",
              "    ) + [Difference - Supply] + [Difference - Stocks] + [Difference - Spread Qty]",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "3fe8f83c-2c3c-4b79-8fb4-4ffa962008d6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - Stocks & Supply",
            "expression": [
              "",
              "[Difference - Stocks] + [Difference - Supply]"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "e2492621-35b1-41c0-bc67-8e7640496340",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Difference - % Hedged Sales",
            "expression": [
              "",
              "IF (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ) = 1,",
              "    [% Hedged sales],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "77eb30c2-285f-45db-85b8-3d688ed6dff6"
          },
          {
            "name": "Difference - % Cobtracted Hedged Sales",
            "expression": [
              "",
              "IF (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ) = 1,",
              "    [% Hedged contracted sales],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "0.00\\ %;-0.00\\ %;0.00\\ %",
            "displayFolder": "Postion & Results\\Position Difference",
            "lineageTag": "912e6c43-c0ae-430b-8021-f3fb3de55250"
          },
          {
            "name": "Balanced M",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Priced M] ),",
              "    BLANK (),",
              "    VAR _date =",
              "        SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "    VAR _month =",
              "        MONTH ( SELECTEDVALUE ( 'REF Calendar'[Date] ) )",
              "    VAR _year =",
              "        YEAR ( SELECTEDVALUE ( 'REF Calendar'[Date] ) )",
              "    RETURN",
              "        CALCULATE (",
              "            AVERAGE ( 'Company Pricing Quotation Forwards'[balance_of_month] ),",
              "            ALL ( 'REF Calendar' ),",
              "            'Company Pricing Quotation Forwards'[reference_date] = _date,",
              "            'REF Calendar'[Date] >= _date,",
              "            'REF Calendar'[Month Of Year] = _month,",
              "            'REF Calendar'[Year] = _year",
              "        )",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "ddd02cf7-7d67-48b7-90c2-321b0ee113a3",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. M/M+1",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M] ) || ISBLANK ( [Full M+1] ),",
              "    BLANK (),",
              "    [Full M] - [Full M+1]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "97273282-5921-4101-b639-d93d3adf7991",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. M/M+12",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M] ) || ISBLANK ( [Full M+12 maturity] ),",
              "    BLANK (),",
              "    [Full M] - [Full M+12 maturity]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "c2ceb5cd-339b-4f9f-aae6-e98b9d6e5475",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. M+12/M+17",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M+12 maturity] ) || ISBLANK ( [Full M+17 maturity] ),",
              "    BLANK (),",
              "    [Full M+12 maturity] - [Full M+17 maturity]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "1382ec3e-7d5a-4046-be0a-ab43358c93b2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Diff. M-1/M",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( [Full M] ) || ISBLANK ( [Full M-1] ),",
              "    BLANK (),",
              "    [Full M-1] - [Full M]",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Differences",
            "lineageTag": "8821c7f8-6b9a-4f26-a3d4-3fe4bb495554",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Rate Exchange",
            "expression": [
              "",
              "SUM ( 'Exchange Rate Values Monitoring'[exchange_rate] )"
            ],
            "displayFolder": "Dashboard Quotations\\Others",
            "lineageTag": "1956c80b-67b7-48f7-bd6b-b4e3f622dcdd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Full M+1",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGE ( 'Forward Periods Averages'[balance_of_month_average] ),",
              "        ALL ( 'REF Calendar' ),",
              "        'REF Month Periods'[month_period_name] = \"M\",",
              "        'Forward Periods Averages'[reference_date] = _date,",
              "        DATEADD ( 'REF Month Periods'[month], 1, MONTH )",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "d722d935-73f5-43bb-bde4-cfdc5b98aeba"
          },
          {
            "name": "Full M+12 maturity",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "VAR _pulication_date =",
              "    CALCULATE (",
              "        MAX ( 'Realized Quotations'[publication_date] ),",
              "        ALL ( 'REF Calendar' ),",
              "        'Realized Quotations'[publication_date] < _date",
              "    )",
              "VAR _invariant_id = [Index ID]",
              "VAR _index = CALCULATE(SELECTEDVALUE('REF PRI'[pricing_quotation_index_id]), ALL('REF PRI'), 'REF PRI'[invariant_id] = _invariant_id)",
              "VAR maturity =",
              "    IF ( ISBLANK ( [Priced M] ), 13, 12 )",
              "RETURN",
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] ),",
              "    ALL ( 'Realized Quotations' ),",
              "    'Realized Quotations'[publication_date] = _pulication_date,",
              "    'Realized Quotations'[maturity_month_number] = maturity,",
              "    'Realized Quotations'[pricing_quotation_index_id] = _index",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Full M\\Maturity",
            "lineageTag": "e02fae41-3109-497b-9224-387b60d251f4",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Full M+17 maturity",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "VAR _pulication_date =",
              "    CALCULATE (",
              "        MAX ( 'Realized Quotations'[publication_date] ),",
              "        ALL ( 'REF Calendar' ),",
              "        'Realized Quotations'[publication_date] < _date",
              "    )",
              "VAR _invariant_id = [Index ID]",
              "VAR _index = CALCULATE(SELECTEDVALUE('REF PRI'[pricing_quotation_index_id]), ALL('REF PRI'), 'REF PRI'[invariant_id] = _invariant_id)",
              "VAR maturity =",
              "    IF ( ISBLANK ( [Priced M] ), 18, 17 )",
              "RETURN",
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] ),",
              "    ALL ( 'Realized Quotations' ),",
              "    'Realized Quotations'[publication_date] = _pulication_date,",
              "    'Realized Quotations'[maturity_month_number] = maturity,",
              "    'Realized Quotations'[pricing_quotation_index_id] = _index",
              ")"
            ],
            "displayFolder": "Dashboard Quotations\\Full M\\Maturity",
            "lineageTag": "af8e575b-16a5-4283-8720-282effb8155d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Full M+6 maturity",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "VAR _pulication_date =",
              "    CALCULATE (",
              "        MAX ( 'Realized Quotations'[publication_date] ),",
              "        ALL ( 'REF Calendar' ),",
              "        'Realized Quotations'[publication_date] < _date",
              "    )",
              "VAR _invariant_id = [Index ID]",
              "VAR _index = CALCULATE(SELECTEDVALUE('REF PRI'[pricing_quotation_index_id]), ALL('REF PRI'), 'REF PRI'[invariant_id] = _invariant_id)",
              "VAR maturity =",
              "    IF ( ISBLANK ( [Priced M] ), 7, 6 )",
              "RETURN",
              "",
              "CALCULATE (",
              "    AVERAGE ( 'Realized Quotations'[quotation_value] ),",
              "    ALL ( 'Realized Quotations' ),",
              "    'Realized Quotations'[publication_date] = _pulication_date,",
              "    'Realized Quotations'[maturity_month_number] = maturity,",
              "    'Realized Quotations'[pricing_quotation_index_id] = _index",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Dashboard Quotations\\Full M\\Maturity",
            "lineageTag": "1fa99554-d02c-4190-92d4-4c74f7a562f8"
          },
          {
            "name": "Full M-1",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "RETURN",
              "    CALCULATE (",
              "        [AVG Quotation value],",
              "        'REF Month Periods'[month_period_name] = \"M-1\",",
              "        'Forward Periods Averages'[reference_date] = _date",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "f35a8137-26c6-4eba-b6bc-ff17bd9a321a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Priced M",
            "expression": [
              "",
              "VAR _date =",
              "    SELECTEDVALUE ( 'REF Calendar'[Date] )",
              "VAR _month =",
              "    MONTH ( SELECTEDVALUE ( 'REF Calendar'[Date] ) )",
              "VAR _year =",
              "    YEAR ( SELECTEDVALUE ( 'REF Calendar'[Date] ) )",
              "RETURN",
              "    IF (",
              "        SUM ( 'Office Days'[quoted_day] ) = 0",
              "            || ISBLANK ( [Full M] ),",
              "        BLANK (),",
              "        CALCULATE (",
              "            AVERAGE ( 'Realized Quotations'[quotation_value] ),",
              "            ALL ( 'REF Calendar' ),",
              "            'REF Calendar'[Date] < _date,",
              "            'REF Calendar'[Month Of Year] = _month,",
              "            'REF Calendar'[Year] = _year,",
              "            'Realized Quotations'[is_closed_day] = 0",
              "        )",
              "    )"
            ],
            "displayFolder": "Dashboard Quotations\\Full M",
            "lineageTag": "c4661a65-5abd-4468-bc51-e2bd444afd31",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Quotation Calculation Date",
            "expression": [
              "",
              "LASTDATE ( 'Company Pricing Quotation Forwards'[reference_date] )"
            ],
            "formatString": "Short Date",
            "displayFolder": "Dashboard Quotations\\Others",
            "lineageTag": "6913a553-d22b-4d2e-9992-6149e77d4d35"
          },
          {
            "name": "max forward date",
            "expression": [
              "",
              "CALCULATE (",
              "    LASTDATE ( 'Company Pricing Quotation Forwards'[reference_date] ),",
              "    ALLEXCEPT (",
              "        'Company Pricing Quotation Forwards',",
              "        'Company Pricing Quotation Forwards'[pricing_quotation_index_id]",
              "    )",
              ")"
            ],
            "formatString": "General Date",
            "displayFolder": "Dashboard Quotations\\Others",
            "lineageTag": "8f234d5a-a878-47c7-8cc2-ce57981b4c98"
          },
          {
            "name": "Diff real vs forecast",
            "expression": [
              "",
              "IF (",
              "    [selected month] <> \"(realised)\",",
              "    BLANK (),",
              "    CALCULATE (",
              "        [Realized Qty] - [Forecast Qty]",
              "            - SUM ( 'Teap Snapshot Entity Month Quantities'[committed_quantity] ),",
              "        'REF Operation Categories'[Op. Cat. Code] = \"SALES\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "42188448-dffa-4245-aaaa-498854a446ab",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "Diff real vs forecast Stock & Supply",
            "expression": [
              "",
              "IF (",
              "    [selected month] <> \"(realised)\",",
              "    BLANK (),",
              "    CALCULATE (",
              "        [Realized Qty] - [Forecast Qty],",
              "        'REF Operation Categories'[P&L Label] = \"Physical Hedge (K$)\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position",
            "lineageTag": "da26c5ed-9b64-4e63-9c39-5a3dd561c4f0"
          },
          {
            "name": "Financial Hedge",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Time Spread Paper Positions',",
              "        'Time Spread Paper Positions'[week_pattern],",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF Paper Index'[very_short_name]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"paper\", [Spread Qty],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Time Spread Paper Positions',",
              "                    'REF Paper Index'[very_short_name],",
              "                    'Time Spread Paper Positions'[week_pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                USERELATIONSHIP ( 'Time Spread Paper Positions'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Time Spread Paper Positions',",
              "                    'REF Paper Index'[very_short_name],",
              "                    'Time Spread Paper Positions'[week_pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                )",
              "            )",
              "    )",
              "VAR _cal =",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [paper] ) / 1000",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "        BLANK (),",
              "        _cal",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "2b5e9fbc-1b51-4612-852a-0046c6530b28"
          },
          {
            "name": "Financial hedge spread",
            "expression": [
              "",
              "[Financial Hedge] - [Financial hedge underlying]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "cbb4d50d-2f07-4a2a-a70a-644e377d448c"
          },
          {
            "name": "Financial hedge underlying",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    CALCULATETABLE (",
              "        SUMMARIZE (",
              "            'Time Spread Paper Positions',",
              "            'Time Spread Paper Positions'[week_pattern],",
              "            'REF Calendar'[Month MM/AA],",
              "            'REF Paper Index'[very_short_name]",
              "        ),",
              "        LEFT ( 'REF Paper Index'[invariant_id], 1 ) <> \"S\" // Filtre sur les papiers non spread",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"paper\", [Spread Qty],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Time Spread Paper Positions',",
              "                    'Time Spread Paper Positions'[week_pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF Paper Index'[invariant_id] = \"PJAAU00H\",",
              "                // Filtre sur JET CIF NWE",
              "                USERELATIONSHIP ( 'Time Spread Paper Positions'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Time Spread Paper Positions',",
              "                    'Time Spread Paper Positions'[week_pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                'REF Paper Index'[invariant_id] = \"PJAAU00H\" // Filtre sur JET CIF NWE",
              "            )",
              "    )",
              "VAR _cal =",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [paper] ) / 1000",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "        BLANK (),",
              "        _cal",
              "    )"
            ],
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "6dd7e8aa-3767-4b15-b015-56df939c6baa",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Physical hedge",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Teap Snapshot Entity Month Quantities',",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF PRI'[very_short_name],",
              "        'Teap Snapshot Entity Month Quantities'[Week Pattern]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"s&s\", [Stocks & Supply],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF PRI'[very_short_name],",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                ),",
              "                USERELATIONSHIP ( 'Teap Snapshot Entity Month Quantities'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                ALLEXCEPT (",
              "                    'Teap Snapshot Entity Month Quantities',",
              "                    'REF PRI'[very_short_name],",
              "                    'REF Snapshots',",
              "                    'Teap Snapshot Entity Month Quantities'[Week Pattern],",
              "                    'REF Calendar'[Month MM/AA]",
              "                )",
              "            )",
              "    )",
              "RETURN",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [s&s] ) / 1000"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "b94a6bd2-b5c7-47fc-aded-6249047d6c06",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Price effect PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Price effect],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Price effect] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "55dabbff-739c-44bd-8518-22088cf2ee1b",
