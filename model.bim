          {
            "name": "Diff. Quty",
            "expression": [
              "",
              "IF (",
              "    ISCROSSFILTERED ( 'Σ Per Flow State'[Flow State] ),",
              "    SWITCH (",
              "        TRUE (),",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Forecasted\", [Diff. Quty Forecasted],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Committed\", [Diff. Quty Committed],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Realized\", [Diff. Quty Realized],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Selected\", [Diff. Quty Selected],",
              "        BLANK ()",
              "    ),",
              "    [Diff. Quty Selected]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Aggregated Flows",
            "lineageTag": "14950fdb-cdd0-415c-aca7-51ac9ffa0abc",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Quty",
            "expression": [
              "",
              "IF (",
              "    ISCROSSFILTERED ( 'Σ Per Flow State'[Flow State] ),",
              "    SWITCH (",
              "        TRUE (),",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Forecasted\", [Quty Forecasted],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Committed\", [Quty Committed],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Realized\", [Quty Realized],",
              "        VALUES ( 'Σ Per Flow State'[Flow State] ) = \"Selected\", [Quty Selected],",
              "        BLANK ()",
              "    ),",
              "    [Quty Selected]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Aggregated Flows",
            "lineageTag": "058e27fb-26f2-4372-bc48-006f5238dd61",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Max date",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( 'REF Snapshots'[Label] ),",
              "    FORMAT ( MAX ( 'REF Snapshots'[Snapshot Last Date] ), \"mm/yyyy\" )",
              ")"
            ],
            "displayFolder": "General measures\\Dates",
            "lineageTag": "75aa5818-886a-4df5-beb4-1eaff82e30a1"
          },
          {
            "name": "Min date",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( 'REF Snapshots'[Label] ),",
              "    MONTH ( MIN ( 'REF Snapshots'[Snapshot Starting Date] ) ) + 1 & \"/\"",
              "        & YEAR ( MIN ( 'REF Snapshots'[Snapshot Starting Date] ) )",
              ")"
            ],
            "displayFolder": "General measures\\Dates",
            "lineageTag": "af8adb8a-723e-4cf0-80f5-1564338ba4c2"
          },
          {
            "name": "AVG Forward BOM RD",
            "expression": [
              "",
              "AVERAGE ( 'Forward Periods Averages'[balance_of_month_average] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Averages",
            "lineageTag": "c8df7fc4-4551-452a-b338-6abc6c11a4eb",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG Last Quote RD",
            "expression": [
              "",
              "AVERAGE ( 'Forward Periods Averages'[last_quote_average] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Averages",
            "lineageTag": "04f4861b-c038-41d8-bcdf-81c4c7203b75",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG Quotation value RD",
            "expression": [
              "",
              "VAR _fwd =",
              "    IF (",
              "        ISCROSSFILTERED ( 'Σ Simulations'[Simulation] ),",
              "        SWITCH (",
              "            TRUE (),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"BOM\", [AVG Forward BOM RD],",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"LAST QUOTE\",",
              "                IF (",
              "                    ISBLANK ( [AVG Last Quote RD] ) = TRUE (),",
              "                    [AVG Forward BOM RD],",
              "                    [AVG Last Quote RD]",
              "                ),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"ADDITION\",",
              "                IF (",
              "                    ISBLANK ( [AVG ε plus RD] ) = TRUE (),",
              "                    [AVG Forward BOM RD],",
              "                    [AVG ε plus RD]",
              "                ),",
              "            SELECTEDVALUE ( 'Σ Simulations'[Simulation] ) = \"SUBTRACTION\",",
              "                IF (",
              "                    ISBLANK ( [AVG ε minus RD] ) = TRUE (),",
              "                    [AVG Forward BOM RD],",
              "                    [AVG ε minus RD]",
              "                )",
              "        ),",
              "        [AVG Forward BOM RD]",
              "    )",
              "VAR _fallback =",
              "    IF ( ISBLANK ( _fwd ), [AVG Realized BOM], _fwd )",
              "VAR _check =",
              "    IF (",
              "        SELECTEDVALUE ( 'Forward Periods Averages'[reference_date] )",
              "            < SELECTEDVALUE ( 'REF Calendar'[Date] ),",
              "        0,",
              "        1",
              "    )",
              "RETURN",
              "    IF ( _check = 1, _fallback, [AVG Realized BOM] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Averages",
            "lineageTag": "776d41ea-2b46-4fd4-b118-1318f822a744",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG ε minus RD",
            "expression": [
              "",
              "AVERAGE ( 'Forward Periods Averages'[epsilon_substraction_average] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Averages",
            "lineageTag": "15892292-544f-4563-9caf-24815fcce48b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "AVG ε plus RD",
            "expression": [
              "",
              "AVERAGE ( 'Forward Periods Averages'[epsilon_addition_average] )"
            ],
            "formatString": "#,##0",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Averages",
            "lineageTag": "04d72d84-266e-4951-b160-42a18daaa1d1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ]
          },
          {
            "name": "M RD",
            "expression": [
              "",
              "--CALCULATE([AVG Quotation value RD],  'REF Month Periods'[month_period_name] = \"M\")",
              "VAR _month =",
              "    MONTH ( SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] ) )",
              "VAR _year =",
              "    YEAR ( SELECTEDVALUE ( 'REF Calendar'[Month MM/AA] ) )",
              "RETURN",
              "    CALCULATE (",
              "        [AVG Quotation value RD],",
              "        'REF Month Periods'[month_period_name] = \"M\",",
              "        MONTH ( 'Forward Periods Averages'[start_date] ) = _month,",
              "        YEAR ( 'Forward Periods Averages'[start_date] ) = _year",
              "    )"
            ],
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "f54a5bee-2452-4e41-9698-c8e2c488b198",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "M-1 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"M-1\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "b3eb1f4d-52c5-4222-b7e1-2ff56557b240"
          },
          {
            "name": "W1 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W1\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "4c625ad4-abbb-42c2-ae66-e93f975fbcde"
          },
          {
            "name": "W-1 RD",
            "expression": [
              "",
              "VAR _sum5 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                [AVG Quotation value RD] * AVERAGE ( 'REF Month Periods'[week_weight] ),",
              "                'REF Month Periods'[month_period_name] <> \"W6\"",
              "            )",
              "    )",
              "VAR _sum6 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                [AVG Quotation value RD] * AVERAGE ( 'REF Month Periods'[week_weight] )",
              "            )",
              "    )",
              "VAR _ratio5 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                AVERAGE ( 'REF Month Periods'[week_weight] ),",
              "                'REF Month Periods'[month_period_name] <> \"W6\"",
              "            )",
              "    )",
              "VAR _ratio6 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\", CALCULATE ( AVERAGE ( 'REF Month Periods'[week_weight] ) )",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( [W6] ),",
              "        DIVIDE ( SUMX ( _sum5, [value] ), SUMX ( _ratio5, [value] ), BLANK () ),",
              "        DIVIDE ( SUMX ( _sum6, [value] ), SUMX ( _ratio6, [value] ), BLANK () )",
              "    )"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "8c1d41f2-9ff6-4eb3-bdf2-c9d5c15017e2"
          },
          {
            "name": "W2 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W2\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Reference Date\\Quotations",
            "lineageTag": "31d8ff1c-6a11-4fbb-bc49-31ecea0c867c"
          },
          {
            "name": "W3 RD",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value RD],",
              "    'REF Month Periods'[month_period_name] = \"W3\"",
