        "partitions": [
          {
            "name": "REF Snapshots-b3145964-a5d3-41b4-a363-c3fc1edf4262",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    dbo_snapshot_synthesis = Source{[Schema=\"dbo\",Item=\"pbi_snapshots\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then dbo_snapshot_synthesis else Table.SelectRows(dbo_snapshot_synthesis, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    ChangedType  = Table.TransformColumnTypes(CompaniesFiltered,{{\"active_snapshot_in_database\", type logical}",
                "                                                        , {\"active_pbi_aggregated_data\", type logical}",
                "                                                        , {\"active_pbi_detailed_data\", type logical}",
                "                                                        , {\"active_snapshot_in_application\", type logical}",
                "                                                        , {\"closing_snapshot\", type logical}",
                "                                                        , {\"is_week_day\", type logical}",
                "                                                        , {\"new_initial_date_snapshot\", type logical}",
                "                                                        , {\"last_validated_snapshots\", type logical}}),",
                "    #\"Extracted Date\" = Table.TransformColumns(ChangedType,{{\"reference_date\", DateTime.Date, type date}}), ",
                "    filtered =  if #\"# Days\" = 0 then #\"Extracted Date\" else Table.SelectRows(#\"Extracted Date\" , each Date.AddDays(Date.From(DateTime.LocalNow()), - #\"# Days\") <= [reference_date]),",
                "    Renamed = Table.RenameColumns(filtered,{{\"active_pbi_aggregated_data\", \"Active PBI Aggregated Data\"}, ",
                "                                 {\"active_pbi_detailed_data\", \"Active PBI Detailed Data\"},",
                "                                 {\"active_snapshot_in_application\", \"Active Snapshot In Application\"}, ",
                "                                 {\"active_snapshot_in_database\", \"Active Snapshot In Database\"}, ",
                "                                 {\"closing_snapshot\", \"Is Closing Snapshot\"}, ",
                "                                 {\"is_week_day\", \"Is Week Day\"}, ",
                "                                 {\"new_initial_date_snapshot\", \"Is New Initial Date Snapshot\"}, ",
                "                                 {\"import_in_pricing_calendar_on\", \"Imported On\"}, ",
                "                                 {\"reference_date\", \"Reference Date\"}, ",
                "                                 {\"snapshot_key\", \"Snapshot Id\"}, ",
                "                                 {\"snapshot_info\", \"Snapshot Info\"}, ",
                "                                 {\"snapshot_starting_date\", \"Snapshot Starting Date\"}, ",
                "                                 {\"state\", \"Snapshot State\"}, ",
                "                                 {\"comments\", \"Comments\"}, ",
                "                                 {\"last_modification_on\", \"Last Modification On\"}, ",
                "                                 {\"snapshot_last_date\", \"Snapshot Last Date\"}, ",
                "                                 {\"new_initial_date_on\", \"New Initial Date On\"}, ",
                "                                 {\"closing_on\", \"Closing On\"}, ",
                "                                 {\"previous_validated_snapshot_id\", \"Previous Validated Snapshot\"}, ",
                "                                 {\"previous_validated_snapshot_reference_date\", \"Previous Validated Snapshot Ref Date\"}, ",
                "                                 {\"unvalidation_date\", \"Unvalidation Date\"}, ",
                "                                 {\"unvalidation_message\", \"Unvalidation Message\"}, ",
                "                                 {\"validation_date\", \"Validation Date\"}, ",
                "                                 {\"validation_message\", \"Validation Message\"}, ",
                "                                 {\"imported_by\", \"Imported By\"}, ",
                "                                 {\"last_modification_by\", \"Last Modification By\"}, ",
                "                                 {\"last_validated_snapshots\", \"Last Validated Snapshots\"}}),",
                "    #\"Type modifié\" = Table.TransformColumnTypes(Renamed,{{\"Reference Date\", type date}}),",
                "    #\"Lignes triées\" = Table.Sort(#\"Type modifié\",{{\"Imported On\", Order.Descending}}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Lignes triées\" ,null,0,Replacer.ReplaceValue,{\"snapshot_id\"}),",
                "    #\"Index ajouté\" = Table.AddIndexColumn(#\"Replaced Value\", \"Index\", 1, 1, Int64.Type),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Index ajouté\",{{\"is_max_imported_date\", type logical}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
