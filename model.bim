            "name": "Sales W-1 Realized",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    ALL ( 'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern & Flow State] ),",
              "    'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern & Flow State] = \"SALES W-1 Realized\"",
              ") / [All sales w/o M]"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
