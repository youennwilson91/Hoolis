        "partitions": [
          {
            "name": "Teap Snapshot Entity Month Quantities",
            "mode": "import",
            "queryGroup": "Data\\Data (SQL Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    dbo_teap_snapshot_entity_month_quantities = Source{[Schema=\"dbo\",Item=\"pbi_teap_snapshot_entity_month_quantities\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then dbo_teap_snapshot_entity_month_quantities else Table.SelectRows(dbo_teap_snapshot_entity_month_quantities, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    SnapshotIDs = Table.Column(#\"REF Snapshots\", \"snapshot_id\"),",
                "    SnapshotFiltered = Table.SelectRows(CompaniesFiltered, each List.Contains(SnapshotIDs,[snapshot_id] )),",
                "    #\"Renamed Columns\" = Table.RenameColumns(SnapshotFiltered,{{\"time_pattern\", \"Time Pattern\"}, {\"pricing_start_date\", \"Pricing Start Date\"}, {\"pricing_end_date\", \"Pricing End Date\"}, {\"month\", \"month/year\"}, {\"op_cat_code_time_pattern\", \"Op Category & Time Pattern\"}, {\"op_cat_code_time_pattern_flow_state\", \"Op Category & Time Pattern & Flow State\"}, {\"week_pattern\", \"Week Pattern\"}})",
                "in",
                "   #\"Renamed Columns\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
