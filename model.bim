          {
            "name": "Sales W-1",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] = \"SALES W-1\",",
              "    ALL('Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern])",
              ")"
            ],
