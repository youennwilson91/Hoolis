      {
        "name": "Measure",
        "lineageTag": "dbcc8d12-175e-465f-a747-a885a44cbc69",
        "partitions": [
          {
            "name": "Measure-360b4868-c6d3-422a-b672-261b5bdfec58",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Diff. Quty Committed",
            "expression": [
              "",
              "VAR snapshots =",
              "    VALUES ( 'REF Snapshots' )",
              "RETURN",
              "    IF (",
              "        AND ( ISCROSSFILTERED ( 'REF Snapshots' ), COUNTROWS ( snapshots ) == 2 )",
              "        ,",
              "        VAR snapshotA =",
              "            MAXX ( snapshots, [Snapshot Id] )",
              "        VAR snapshotB =",
              "            MINX ( snapshots, [Snapshot Id] )",
              "        VAR qtySnapA =",
              "            CALCULATE (",
              "                SUM ( 'DATA Aggregated Flows'[committed_quantity] ),",
              "                'REF Snapshots'[Snapshot Id] = snapshotA",
              "            )",
              "        VAR qtySnapB =",
              "            CALCULATE (",
              "                SUM ( 'DATA Aggregated Flows'[committed_quantity] ),",
              "                'REF Snapshots'[Snapshot Id] = snapshotB",
              "            )",
              "        RETURN",
              "            qtySnapA - qtySnapB,",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,0",
            "isHidden": true,
            "displayFolder": "Aggregated Flows\\Hidden",
            "lineageTag": "fd1f9243-1210-4ede-b92f-956b174b8fac",
            "changedProperties": [
              {
                "property": "FormatString"
              },
              {
                "property": "IsHidden"
              }
            ],
