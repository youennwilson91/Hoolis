        "partitions": [
          {
            "name": "REF Pricing Areas-648947cb-96f1-4144-b4a2-5d29d72d514d",
            "mode": "import",
            "queryGroup": "Referentials\\Referentials (Company Filtered)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(Server,Database),",
                "    data = Source{[Schema=\"dbo\",Item=\"pbi_pricing_areas\"]}[Data],",
                "    CompaniesFiltered = if (CompaniesCodes = \"ALL\") then data else Table.SelectRows(data, each List.Contains(#\"BASE CompaniesCompanyId\",[company_id] )),",
                "    Renamed = Table.RenameColumns(CompaniesFiltered,{{\"pricing_area_code\", \"Pricing Area Code\"}, {\"pricing_area_text_en\", \"Pricing Area Text EN\"}, {\"pricing_area_text_fr\", \"Pricing Area Text FR\"}, {\"pricing_area_pricing_impact\", \"Pricing Area Pricing Impact\"}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(Renamed, \"Custom\", each if [Pricing Area Code] = \"NWE\" then \"JET CIF NWE\" else if [Pricing Area Code] = \"ARA\" then \"JET FOB ARA\" ",
                "    else if [Pricing Area Code] = \"MED\" then \"JET FOB MED\" else if [Pricing Area Code] = \"SG\" then \"JET FOB SG\" else null, type text),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Added Conditional Column\",{{\"Custom\", \"Index name\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
