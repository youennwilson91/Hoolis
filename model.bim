          {
            "name": "Net Exposure Previous Year",
            "expression": [
              "CALCULATE(",
              "    IF (",
              "        2 IN VALUES ( 'Teap Snapshot Entity Month Quantities'[aggregated_flow_type] ),",
              "        // Mois réalisés",
              "        CALCULATE (",
              "            [Stocks] + [Supply M-1] + [Sales M-1],",
              "            'REF Flow State'[Flow State] = \"Realized\"",
              "        )",
              "            + CALCULATE (",
              "                0.3 * ( [Sales W-1] + [Supply W-1] ),",
              "                'REF Flow State'[Flow State] = \"Realized\"",
              "            ),",
              "        //Mois forward",
              "        CALCULATE (",
              "            [Stocks] + [Supply M-1] + 0.3 * [Supply W-1],",
              "            'REF Flow State'[Flow State] = \"Forecasted\"",
              "        )",
              "            + CALCULATE (",
              "                [Sales M-1] + 0.3 * [Sales W-1],",
              "                'REF Flow State'[Flow State] IN { \"Forecasted\", \"Committed\" }",
              "            )",
              "    ) ",
              "    + [Spread Qty Pattern M-1] + 0.3 * [Spread Qty Pattern W-1],",
              "    ",
              "            DATEADD('REF Calendar'[Date], -1, YEAR)",
              "            )"
