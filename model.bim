              }
            ]
          },
          {
            "name": "Result excl. Structure spread PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Result excl. Structure spread],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Result excl. Structure spread] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "a7ca0587-1466-4d7f-bbf5-6a5dbce8f4ce",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Result excl. Structure underlying PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Result excl. Structure underlying],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Result excl. Structure underlying] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "0a79be07-39d9-46e3-a964-b91cb8906ea1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "RPCD - Result excl. Structure spread",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Result excl. Structure spread PIPE CEPS],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Result excl. Structure spread PIPE CEPS],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Result excl. Structure spread PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps Difference",
            "lineageTag": "dc58d231-bf18-4379-ba1b-9763a7d1b7b6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "RPCD - Result excl. Structure underlying",
            "expression": [
              "",
              "SWITCH (",
              "    DISTINCTCOUNT ( 'REF Snapshots'[Snapshot Id] ),",
              "    2,",
              "        VAR _first_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MIN ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        VAR _last_snapshot =",
              "            CALCULATE (",
              "                SELECTEDVALUE ( 'REF Snapshots'[Snapshot Id] ),",
              "                'REF Snapshots'[Imported On] = MAX ( 'REF Snapshots'[Imported On] )",
              "            )",
              "        RETURN",
              "            CALCULATE (",
              "                [Result excl. Structure underlying PIPE CEPS],",
              "                'REF Snapshots'[Snapshot Id] = _last_snapshot",
              "            )",
              "                - CALCULATE (",
              "                    [Result excl. Structure underlying PIPE CEPS],",
              "                    'REF Snapshots'[Snapshot Id] = _first_snapshot",
              "                ),",
              "    1, [Result excl. Structure underlying PIPE CEPS],",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps Difference",
            "lineageTag": "7e22c5c7-1e6e-4668-b95c-3bd43757133f",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Financial Hedge FIX",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    SUMMARIZE (",
              "        'Time Spread Paper Positions',",
              "        'Time Spread Paper Positions'[week_pattern],",
              "        'REF Calendar'[Month MM/AA],",
              "        'REF Paper Index'[very_short_name]",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"paper\", [Spread Qty],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                USERELATIONSHIP ( 'Time Spread Paper Positions'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "                [M]",
              "",
              "    )",
              "VAR _cal =",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [paper] ) / 1000",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "        BLANK (),",
              "        _cal",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "63270eff-a674-4fe4-a5d6-888513187843"
          },
          {
            "name": "Financial hedge spread FIX",
            "expression": [
              "",
              "[Financial Hedge] - [Financial hedge underlying]"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "3bc9d5e0-4792-45d4-ac86-d708fba8a776"
          },
          {
            "name": "Financial hedge underlying FIX",
            "expression": [
              "",
              "VAR _summerizeweek =",
              "    CALCULATETABLE (",
              "        SUMMARIZE (",
              "            'Time Spread Paper Positions',",
              "            'Time Spread Paper Positions'[week_pattern],",
              "            'REF Calendar'[Month MM/AA],",
              "            'REF Paper Index'[very_short_name]",
              "        ),",
              "        LEFT ( 'REF Paper Index'[invariant_id], 1 ) <> \"S\" // Filtre sur les papiers non spread",
              "    )",
              "VAR _addweek =",
              "    ADDCOLUMNS (",
              "        _summerizeweek,",
              "        \"paper\", [Spread Qty],",
              "        \"avg quot. W\",",
              "            CALCULATE (",
              "                [AVG Quotation value],",
              "                'REF Paper Index'[invariant_id] = \"PJAAU00H\",",
              "                // Filtre sur JET CIF NWE",
              "                USERELATIONSHIP ( 'Time Spread Paper Positions'[Key_QTY], 'REF Month Periods'[Key_QTY] )",
              "            ),",
              "        \"avg quot. M\",",
              "            CALCULATE (",
              "                [M],",
              "                'REF Paper Index'[invariant_id] = \"PJAAU00H\" // Filtre sur JET CIF NWE",
              "            )",
              "    )",
              "VAR _cal =",
              "    - SUMX ( _addweek, ( [avg quot. W] - [avg quot. M] ) * [paper] ) / 1000",
              "RETURN",
              "    IF (",
              "        SELECTEDVALUE ( 'Period Selection'[Period Selection] ) = \"Difference\",",
              "        BLANK (),",
              "        _cal",
              "    )"
            ],
            "displayFolder": "Postion & Results\\P&L",
            "lineageTag": "5e599434-07e9-48bd-83e0-8501ebd1ff67",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
