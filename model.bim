          {
            "name": "All sales w/o M",
            "expression": [
              "",
              "CALCULATE (",
              "    [Physical Position],",
              "    'REF Operation Categories'[Op. Cat. Code] = \"SALES\",",
              "    'Teap Snapshot Entity Month Quantities'[Week Pattern] <> \"M\",",
              "    ALL ( 'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern] ),",
              "    ALL ( 'Teap Snapshot Entity Month Quantities'[Op Category & Time Pattern & Flow State] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Postion & Results\\Position\\Sales",
