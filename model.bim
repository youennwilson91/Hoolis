              "        ALL ( 'REF Snapshots' ),",
              "        'REF Snapshots'[Snapshot Id] = _max,",
              "        DATEADD('REF Calendar'[Date], -2, MONTH)",
              "    )",
              "RETURN",
              "    IF (",
              "        ROUND (",
              "            _calculate - CALCULATE(SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ), DATEADD('REF Calendar'[Date], -2, MONTH)),",
              "            0            ",
              "        ) <> 0,          ",
              "        ROUND (          ",
              "            _calculate - CALCULATE(SUM ( 'Teap Snapshot Entity Month Quantities'[selected_quantity] ), DATEADD('REF Calendar'[Date], -2, MONTH)),",
              "            0",
              "        ),",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Volume Effects\\M-2",
