          },
          {
            "name": "(W-1/M) / (M-1/M)",
            "expression": [
              "",
              "DIVIDE ( [W-1/M], [M-1/M], BLANK () )"
            ],
            "formatString": "0\\ %;-0\\ %;0\\ %",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Structures",
            "lineageTag": "29c0a5c3-b648-497f-9291-a88af72d30df"
          },
          {
            "name": "W6",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W6\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "b9b5c384-6298-43b0-a48a-dc2eafb2c15e"
          },
          {
            "name": "W5",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W5\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "ae52a478-b057-406a-8ad0-1c08333df09d"
          },
          {
            "name": "W4",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W4\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "f23428bc-d4c0-41ef-97e4-e9599b6016d3"
          },
          {
            "name": "W3",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W3\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "e86ec57c-08db-4eee-b1e8-bba7508ee828"
          },
          {
            "name": "W2",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W2\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "7f597898-f0dc-47a4-8bb4-64123e52fee6"
          },
          {
            "name": "W-1",
            "expression": [
              "",
              "VAR _sum5 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                [AVG Quotation value] * AVERAGE ( 'REF Month Periods'[week_weight] ),",
              "                'REF Month Periods'[month_period_name] <> \"W6\"",
              "            )",
              "    )",
              "VAR _sum6 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                [AVG Quotation value] * AVERAGE ( 'REF Month Periods'[week_weight] )",
              "            )",
              "    )",
              "VAR _ratio5 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\",",
              "            CALCULATE (",
              "                AVERAGE ( 'REF Month Periods'[week_weight] ),",
              "                'REF Month Periods'[month_period_name] <> \"W6\"",
              "            )",
              "    )",
              "VAR _ratio6 =",
              "    SUMMARIZE (",
              "        'REF Month Periods',",
              "        'REF Month Periods'[month_period_name],",
              "        \"value\", CALCULATE ( AVERAGE ( 'REF Month Periods'[week_weight] ) )",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( [W6] ),",
              "        DIVIDE ( SUMX ( _sum5, [value] ), SUMX ( _ratio5, [value] ), BLANK () ),",
              "        DIVIDE ( SUMX ( _sum6, [value] ), SUMX ( _ratio6, [value] ), BLANK () )",
              "    )"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "81554d03-03d6-4e16-b913-c7383de9a02d"
          },
          {
            "name": "W1",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
              "    'REF Month Periods'[month_period_name] = \"W1\"",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "General measures\\Quotations\\By Snapshot\\Quotations values",
            "lineageTag": "89063189-b142-43c5-b266-90ccaf8b6434"
          },
          {
            "name": "M-1",
            "expression": [
              "",
              "CALCULATE (",
              "    [AVG Quotation value],",
