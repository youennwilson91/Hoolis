          {
            "name": "Spread Qty Pattern M-1",
            "expression": "CALCULATE([Spread Qty], 'Time Spread Paper Positions'[Time Pattern] = \"M-1\")",
            "displayFolder": "Postion & Results\\Position\\Manoeuvrabilité",
            "lineageTag": "0c8031e5-275a-477e-8253-474d9d05e87a",
            "annotations": [
