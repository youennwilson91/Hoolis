              }
            ]
          },
          {
            "name": "Physical Result underlying PIPE CEPS",
            "expression": [
              "",
              "VAR _PIPE =",
              "    CALCULATE (",
              "        [Physical Result underlying],",
              "        ALL ( 'REF Entities' ),",
              "        'REF Entities'[invariant_id] = \"CEPS\"",
              "    )",
              "        * SUM ( 'REF Ratio PIPE CEPS'[ratio] )",
              "RETURN",
              "    [Physical Result underlying] + _PIPE"
            ],
            "formatString": "#,0",
            "displayFolder": "Postion & Results\\P&L Ratio Pipe Ceps",
            "lineageTag": "8fd93d58-1395-49dd-a272-fad3cf1ffc03",
            "annotations": [
              {
                "name": "PBI_FormatHint",
