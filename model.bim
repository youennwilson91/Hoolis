          {
            "type": "calculated",
            "name": "Key",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "",
              "    'Teap Hedging Simulation'[start_date]",
              "    & \" | \" & ",
              "    'Teap Hedging Simulation'[end_date]",
              "    & \" | \" & ",
              "    'Teap Hedging Simulation'[month]"
            ],
            "lineageTag": "ab413d15-a61f-427c-b891-24432a985242",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Week Pattern",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "var _rank = ",
              "SWITCH(",
              "        TRUE(),",
              "            'Teap Hedging Simulation'[projection_type] = 1,",
              "                RANK(",
              "                    DENSE,",
              "                    ,",
              "                    ORDERBY([start_date]),",
              "                    FIRST,",
              "                    PARTITIONBY(",
              "                        'Teap Hedging Simulation'[snapshot_id],",
              "                        'Teap Hedging Simulation'[projection_type],",
              "                        'Teap Hedging Simulation'[paper_quotation_index_id],",
              "                        'Teap Hedging Simulation'[month]",
              "                    )",
              "                ),",
              "            'Teap Hedging Simulation'[projection_type] = 0, -1",
              "",
              "    )",
              "",
              "--var _week_rank =",
              "--if(",
              "--    MONTH('Teap Hedging Simulation'[start_date]) <> MONTH('Teap Hedging Simulation'[end_date]),",
              "--    0,",
              "--    _rank",
              "--)",
              "",
              "return",
              "",
              "SWITCH(",
              "    TRUE(),",
              "    _rank = 1, \"W1\",",
              "    _rank = 2, \"W2\",",
              "    _rank = 3, \"W3\",",
              "    _rank = 4, \"W4\",",
              "    _rank = 5, \"W5\",",
              "    _rank = 6, \"W6\",",
              "    _rank = -1, \"M-1\"",
              ")"
            ],
            "lineageTag": "47db0b74-1bee-48b5-989c-2b54d388a394",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
